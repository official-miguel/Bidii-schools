// =============================================================================
// Library enums
// =============================================================================

enum LibraryIdentMethod {
  /// Librarian types the admission number or book number manually
  MANUAL
  /// Device camera scans QR codes
  QR_CAMERA
  /// USB/Bluetooth hardware scanner auto-feeds scans
  QR_HARDWARE
}

enum LibraryCardStatus {
  /// Card is valid and student may borrow
  ACTIVE
  /// Card is temporarily blocked (e.g. unpaid fines, disciplinary hold)
