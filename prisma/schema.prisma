generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One row per registered school. Created by the signup flow, along with the
/// Principal's own User row, in a single transaction — this is the "school
/// account" the rest of the system is scoped to.
model School {
  id                       String                    @id @default(cuid())
  name                     String
  /// Short URL-safe handle, e.g. "green-hill-academy" — reserved for a
  /// future school-specific login URL; not required at login today (login is
  /// by email, which is unique per school).
  slug                     String                    @unique
  address                  String?
  phone                    String?
  email                    String?
  /// School branding & configuration
  logoUrl                  String?
  stampUrl                 String?
  motto                    String?
  /// DAY_ONLY | DAY_AND_BOARDING | BOARDING_ONLY
  boardingType             String                    @default("DAY_AND_BOARDING")
  /// MIXED | BOYS_ONLY | GIRLS_ONLY
  genderPolicy             String                    @default("MIXED")
  /// When true, every new student registration triggers round-robin dorm assignment
  autoAllocateDorms        Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  attendances              Attendance[]
  calendarEvents           CalendarEvent[]
  departments              Department[]
  classes                  SchoolClass[]
  integrations             SchoolIntegration[]
  staffRoles               StaffRole[]
  students                 Student[]
  subjects                 Subject[]
  teachers                 Teacher[]
  timetableConfig          TimetableConfig?
  timetableSlots           TimetableSlot[]
  users                    User[]
  disciplineRecords        DisciplineRecord[]
  achievements             Achievement[]
  studentFiles             StudentFile[]
  classSubjectProfiles     ClassSubjectProfile[]
  classElectiveGroupTeachers ClassElectiveGroupTeacher[]
  /// Assessment framework models
  assessmentFrameworks     AssessmentFramework[]
  assessmentPeriods        AssessmentPeriod[]
  /// 8-4-4 hierarchy
  papers                   Paper[]
  /// CBE pathway weights
  pathwayWeights           PathwayWeight[]
  /// Ranking weight configuration (examination analytics)
  rankingConfig            RankingConfig?
  /// Report remarks (examination analytics)
  reportRemarks            ReportRemark[]
  /// Subject-expectation configuration
  formSubjectExpectations  FormSubjectExpectation[]
  /// CBC hierarchy
  learningAreas            LearningArea[]
  strands                  Strand[]
  subStrands               SubStrand[]
  /// CBE hierarchy
  competencyUnits          CompetencyUnit[]
  elements                 CompetencyElement[]
  performanceCriteria      PerformanceCriterion[]
  /// Assessment items & RBAC
  assessmentItems          AssessmentItem[]
  assessmentRoles          AssessmentRole[]
  /// Library (v1 legacy)
  librarySettings          LibrarySettings?
  libraryBooks             LibraryBook[]
  libraryCards             LibraryCard[]
  libraryBorrows           LibraryBorrow[]
  /// Library (v2 enterprise)
  libraryCatalogues        LibraryCatalogue[]
  libraryCopies            LibraryCopy[]
  /// Library Stage 2
  libraryPolicies          LibraryPolicy[]
  libraryFineAudits        LibraryFineAudit[]
  libraryFinePauses        LibraryFinePause[]
  libraryReservations      LibraryReservation[]
  libraryClassroomLoans    LibraryClassroomLoan[]
  libraryCirculationEvents LibraryCirculationEvent[]
  /// Messaging / Communication Centre
  messages                 Message[]
  messageLogs              MessageLog[]
  recipientGroups          RecipientGroup[]
  messageTemplates         MessageTemplate[]
  messagingSettings        MessagingSettings?
  /// Lifecycle management
  recycledStaffIds         RecycledStaffId[]
  auditLogs                AuditLog[]
  permissionAuditLogs      PermissionAuditLog[]      @relation("PermAuditSchool")
  /// Accommodation module
  accommodationSettings    AccommodationSettings?
  dormitories              Dormitory[]
  cubicles                 Cubicle[]
  beds                     Bed[]
  sleepingPositions        SleepingPosition[]
  allocationRecords        AllocationRecord[]
  dormInspections          DormInspection[]
  accommodationEvents      AccommodationEvent[]
  /// Versioned timetable engine
  timetableVersions        TimetableVersion[]
  timetableVersionSlots    TimetableVersionSlot[]
  timetableChangeLogs      TimetableChangeLog[]
  /// Elective groups
  electiveGroups           ElectiveGroup[]
  electiveGroupTeachers    ElectiveGroupTeacher[]
  /// HOD formula configs
  departmentFormulaConfigs DepartmentFormulaConfig[]
  /// Supabase Storage metadata
  storedImages             StoredImage[]
  storedReports            StoredReport[]
  /// Super-admin control plane
  schoolMeta               SchoolMeta?
  schoolModuleToggles      SchoolModuleToggle[]
  systemErrors             SystemError[]
  storageUsages            StorageUsage[]
  importJobs               ImportJob[]
  /// Fees & Ledger module
  financeSettings          FinanceSettings?
  mpesaPaybills            SchoolMpesaPaybill[]
  financialTermNames       FinancialTermName[]
  feeStructures            FeeStructure[]
  expenseCategories        ExpenseCategory[]
  expenseItems             ExpenseItem[]
  terms                    Term[]
  studentFinanceAccounts   StudentFinanceAccount[]
  ledgerEntries            LedgerEntry[]
  invoices                 Invoice[]
  payments                 Payment[]
  expenseAttachments       StudentExpenseAttachment[]
  mpesaQueue               MpesaReconciliationQueue[]
  debtorFlags              DebtorFlag[]
  financeNotifications     FinanceNotification[]
  financeImportJobs        FinanceImportJob[]
}

/// One row per login. Role determines which dashboard the user lands on.
/// schoolId scopes every user (including the Principal) to exactly one
/// school — this is what makes "log in and land inside your own school's
/// system" work.
/// Email is unique per school, not globally — the same person can hold
/// accounts at multiple schools using the same email address.
model User {
  id                        String               @id @default(cuid())
  email                     String
  /// Bcrypt password hash.
  /// On first login the hash is of the school slug (e.g. "kianyaga").
  /// mustChangePassword is set true so the teacher is forced to set a
  /// personal password before reaching the dashboard.  After that the hash
  /// is replaced with the teacher's own password and the school slug can
  /// never be used again (enforced in /api/auth/change-password).
  passwordHash              String?
  role                      Role
  mustChangePassword        Boolean              @default(false)
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  /// Nullable for SUPER_ADMIN accounts which are not scoped to any school.
  schoolId                  String?
  /// Only meaningful when role = ADMIN_STAFF. Governs which modules this
  /// login can see and manage (Staff Roles & Permissions). PRINCIPAL always
  /// has full access regardless of this field; TEACHER keeps its existing
  /// fixed capabilities (own class, own subjects, marks entry) unaffected by
  /// the RBAC system so nothing about the teacher flow changes.
  staffRoleId               String?
  /// Profile photo — Supabase Storage path (images bucket), e.g.
  /// "{schoolId}/{userId}/avatar.jpg". Use storage helpers to resolve to URL.
  avatarUrl                 String?
  /// Supabase Storage path for the user's avatar (mirrors avatarUrl; kept
  /// separate so the raw path is available without parsing the full URL).
  avatarStoragePath         String?
  calendarEvents            CalendarEvent[]
  sessions                  Session[]
  student                   Student?
  teacher                   Teacher?
  school                    School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffRole                 StaffRole?           @relation(fields: [staffRoleId], references: [id])
  disciplineRecordsRecorded DisciplineRecord[]
  disciplineNotes           DisciplineNote[]
  disciplineEvents          DisciplineEvent[]
  studentFilesUploaded      StudentFile[]
  achievementsRecorded      Achievement[]
  sentMessages              Message[]
  studentsArchived          Student[]            @relation("StudentArchivedBy")
  staffArchived             Teacher[]            @relation("TeacherArchivedBy")
  auditLogs                 AuditLog[]
  /// Multi-role assignments (new; legacy single-role via staffRoleId is kept)
  userStaffRoles            UserStaffRole[]
  /// Permission audit log entries performed by this user
  permissionAuditLogs       PermissionAuditLog[] @relation("PermissionAuditPerformedBy")
  /// Permission audit log entries targeting this user
  permissionAuditLogsTarget PermissionAuditLog[] @relation("PermissionAuditTarget")
  /// Accommodation
  accommodationAllocations  AllocationRecord[]   @relation("AccommodationAllocatedBy")
  dormInspectionsPerformed  DormInspection[]
  accommodationEvents       AccommodationEvent[]
  /// Fees & Ledger back-relations
  feeStructuresCreated      FeeStructure[]
  termsCreated              Term[]
  ledgerEntriesPosted       LedgerEntry[]
  invoicesGenerated         Invoice[]
  paymentsPosted            Payment[]
  expenseAttachmentsAdded   StudentExpenseAttachment[] @relation("ExpenseAttachedBy")
  expenseAttachmentsRemoved StudentExpenseAttachment[] @relation("ExpenseDetachedBy")
  financeImportJobsCreated  FinanceImportJob[]

  /// Email uniqueness is scoped to one school — same email OK at different schools
  @@unique([schoolId, email])
  @@index([role])
  @@index([schoolId])
  @@index([staffRoleId])
}

/// Opaque bearer token stored server-side (not a JWT) so sessions can be
/// revoked instantly from the principal's Staff & Roles panel.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Section 2A.2 — groups subjects under an administrative unit with a head.
/// Name is unique per school, not globally — two schools can each have a
/// "Sciences" department.
model Department {
  id            String    @id @default(cuid())
  name          String
  headTeacherId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  schoolId      String
  headTeacher   Teacher?  @relation("DepartmentHead", fields: [headTeacherId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects        Subject[]
  teachers        Teacher[] @relation("TeacherPrimaryDepartment")
  formulaConfigs  DepartmentFormulaConfig[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// Section 2A.1 — the master subject list every downstream module reads from.
/// Code is unique per school, not globally.
model Subject {
  id                  String                     @id @default(cuid())
  name                String
  /// School-chosen short code, e.g. "BIO" or "MAT"
  code                String
  /// Auto-incrementing internal code assigned in registration order, never reused.
  /// This is the stable join key for timetable generation, invisible to users.
  internalCode        Int
  type                SubjectType                @default(CORE)
  departmentId        String
  /// Forms/year groups this subject applies to, e.g. [3, 4] for Form 3 & 4 only.
  applicableForms     Int[]
  /// Which curriculum frameworks this subject belongs to.
  /// A subject can appear in multiple frameworks (e.g. both 8-4-4 and CBC).
  /// A class will show this subject if its own frameworkType is in this array.
  /// Defaults to [EIGHT_FOUR_FOUR] so existing subjects stay visible in 8-4-4 classes.
  frameworkTypes      FrameworkType[]            @default([EIGHT_FOUR_FOUR])
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  schoolId            String
  /// Whether this subject requires consecutive double lesson blocks
  doubleLesson        Boolean                    @default(false)
  /// What kind of room this subject requires, e.g. "Lab", "Computer Lab"
  requiresSpecialRoom String?
  classTeachers       ClassSubjectTeacher[]
  studentElectives    StudentElective[]
  electiveGroupMembers ElectiveGroupMember[]
  electiveGroupTeachers ElectiveGroupTeacher[]
  classElectiveGroupTeachers ClassElectiveGroupTeacher[]
  /// Assessment framework back-relations
  papers              Paper[]
  assessmentItems     AssessmentItem[]
  assessmentRoles     AssessmentRole[]
  pathwayWeights      PathwayWeight[]
  department          Department                 @relation(fields: [departmentId], references: [id])
  school              School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects     TeacherSubject[]
  timetableSlots      TimetableSlot[]
  /// Per-class lesson requirements
  lessonRequirements  SubjectLessonRequirement[]
  /// Per-class subject type overrides (class profile)
  classSubjectProfiles ClassSubjectProfile[]
  /// HOD formula overrides for this subject
  formulaConfigs       DepartmentFormulaConfig[]

  @@unique([schoolId, code])
  @@unique([schoolId, internalCode])
  @@index([departmentId])
  @@index([schoolId])
}

/// Section 2B — staff registry. userId is optional so a teacher record can be
/// pre-created before login credentials are issued. staffId is unique per
/// school, not globally.
model Teacher {
  id                     String                  @id @default(cuid())
  userId                 String?                 @unique
  staffId                String
  fullName               String
  designation            String?
  email                  String?
  phone                  String?
  primaryDepartmentId    String?
  todEligible            Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  schoolId               String
  /// Lifecycle management: when a staff member leaves the institution
  archivedAt             DateTime?
  /// TRANSFER (generic departure)
  archiveType            String?
  /// Departure reason / notes
  archiveReason          String?
  /// User who performed the archive action
  archivedById           String?
  /// Employment period — snapshot taken at archive time
  employmentStartDate    DateTime?
  designationSnapshot    String?
  departmentSnapshot     String?
  attendancesRecorded    Attendance[]
  subjectAssignments     ClassSubjectTeacher[]
  departmentHeadOf       Department?             @relation("DepartmentHead")
  /// Assessment framework back-relations
  assessmentItemsEntered AssessmentItem[]
  assessmentRoles        AssessmentRole[]
  classTeacherOf         SchoolClass?            @relation("ClassTeacher")
  primaryDepartment      Department?             @relation("TeacherPrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id])
  archivedBy             User?                   @relation("TeacherArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  teacherSubjects        TeacherSubject[]
  unavailability         TeacherUnavailability[]
  timetableSlots         TimetableSlot[]
  groupMemberships       GroupMember[]
  electiveGroupTeachers  ElectiveGroupTeacher[]
  classElectiveGroupTeachers ClassElectiveGroupTeacher[]
  /// Accommodation: dorms this teacher is the boarding master for
  dormsBoardingMaster    Dormitory[]             @relation("DormBoardingMaster")

  @@unique([schoolId, staffId])
  @@index([primaryDepartmentId])
  @@index([schoolId])
  /// History module queries
  @@index([schoolId, archivedAt])
}

/// Tracks staff IDs that have been freed by departing staff and can be
/// recycled for new registrations. Unique per (schoolId, staffId) pair.
model RecycledStaffId {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffId])
  @@index([schoolId, staffId])
}

/// Section: Staff Roles & Permissions (RBAC). A Principal-defined role such
/// as "Accountant" or "Librarian" — a named bundle of module permissions
/// that any number of ADMIN_STAFF logins can be assigned. Scoped per school,
/// so each school curates its own set of roles. Deleting a role is blocked
/// while any User still has it (see the API route) rather than silently
/// leaving orphaned logins with no permissions.
model StaffRole {
  id          String           @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Legacy single-role FK (kept for backward compatibility)
  users       User[]
  /// New multi-role join table
  userRoles   UserStaffRole[]  @relation("StaffRoleUsers")

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// One row per (role, module) pair. Granular action flags: canView is read-only
/// access; canCreate/canEdit/canDelete/canApprove/canExport/canPrint/canManage/
/// canConfigure/canAIAccess are additive capabilities on top of view. canManage
/// is the legacy "full access" shorthand (implies all write actions). A module
/// with no row at all for a role is treated as no access.
model RolePermission {
  staffRoleId  String
  module       Module
  canView      Boolean   @default(false)
  canCreate    Boolean   @default(false)
  canEdit      Boolean   @default(false)
  canDelete    Boolean   @default(false)
  canApprove   Boolean   @default(false)
  canExport    Boolean   @default(false)
  canPrint     Boolean   @default(false)
  canManage    Boolean   @default(false)
  canConfigure Boolean   @default(false)
  canAIAccess  Boolean   @default(false)
  staffRole    StaffRole @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)

  @@id([staffRoleId, module])
}

/// Many-to-many: a staff user can hold multiple StaffRoles simultaneously.
/// Permissions from all assigned roles are merged (union) at runtime.
/// The legacy User.staffRoleId is kept for backward compatibility — rows
/// added here are the authoritative multi-role source.
model UserStaffRole {
  userId       String
  staffRoleId  String
  assignedAt   DateTime  @default(now())
  assignedById String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole    StaffRole @relation("StaffRoleUsers", fields: [staffRoleId], references: [id], onDelete: Cascade)

  @@id([userId, staffRoleId])
  @@index([userId])
  @@index([staffRoleId])
}

/// Immutable audit log for every permission grant, revocation, or change.
/// Never deleted — provides a complete history for compliance and security review.
model PermissionAuditLog {
  id            String   @id @default(cuid())
  schoolId      String
  /// The user who made the change (principal or delegated admin)
  performedById String
  /// The user whose permissions changed
  targetUserId  String?
  /// The StaffRole affected (if role-level change)
  staffRoleId   String?
  /// The module affected
  module        Module?
  /// What action was taken: ROLE_CREATED, ROLE_UPDATED, ROLE_DELETED,
  /// PERMISSION_GRANTED, PERMISSION_REVOKED, ROLE_ASSIGNED, ROLE_UNASSIGNED
  action        String
  /// JSON snapshot of what changed { before: {...}, after: {...} }
  changes       Json?
  createdAt     DateTime @default(now())
  school        School   @relation("PermAuditSchool", fields: [schoolId], references: [id], onDelete: Cascade)
  performedBy   User     @relation("PermissionAuditPerformedBy", fields: [performedById], references: [id], onDelete: Cascade)
  targetUser    User?    @relation("PermissionAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([performedById])
  @@index([targetUserId])
  @@index([staffRoleId])
  @@index([schoolId, createdAt])
}

/// One row per (school, provider) — e.g. this school's own Gemini API key.
/// Every school brings its own credentials; nothing here is a shared
/// Anthropic/Anthropic-hosted key. `encryptedValue` is AES-256-GCM
/// ciphertext (see src/lib/crypto.ts), never the raw secret — even a full
/// database dump doesn't hand out usable API keys without
/// INTEGRATION_ENCRYPTION_KEY, which lives only in server env vars.
/// `metadata` holds non-secret, provider-specific extras (e.g. an SMTP
/// host/from-address, or a WhatsApp sender number) that don't need
/// encrypting but do need to travel with the key.
model SchoolIntegration {
  id             String              @id @default(cuid())
  schoolId       String
  provider       IntegrationProvider
  encryptedValue String
  /// Last 4 characters of the plaintext key, shown in the UI so a Principal
  /// can recognize which key is saved without ever re-displaying the full
  /// value.
  keyPreview     String
  metadata       Json?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
  @@index([schoolId])
}

/// Join table: which subjects a teacher is assigned to teach (2B.1).
model TeacherSubject {
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

/// e.g. "Form 3 North". Name and classTeacherId are unique per school.
model SchoolClass {
  id                 String                     @id @default(cuid())
  name               String
  form               Int
  stream             String?
  classTeacherId     String?                    @unique
  /// Which curriculum framework students in this class are assessed under.
  /// Set once at class creation; immutable after that. All students in the
  /// class inherit this value — no per-student switching.
  frameworkType      FrameworkType              @default(EIGHT_FOUR_FOUR)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  schoolId           String
  attendances        Attendance[]
  subjectTeachers    ClassSubjectTeacher[]
  classTeacher       Teacher?                   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students           Student[]
  timetableSlots     TimetableSlot[]
  lessonRequirements SubjectLessonRequirement[]
  /// Per-class subject type overrides (class profile)
  classSubjectProfiles ClassSubjectProfile[]
  /// Per-class elective group teacher pairings
  classElectiveGroupTeachers ClassElectiveGroupTeacher[]

  @@unique([schoolId, name])
  @@index([schoolId, form])
}

/// Section 2D — student registry. Admission number is the identifier
/// referenced by results entry, marking dashboard, and parent linking (11B).
/// Unique per school, not globally — two schools can both have admission
/// number "001".
model Student {
  id                       String               @id @default(cuid())
  userId                   String?              @unique
  admissionNumber          String
  fullName                 String
  gender                   String?
  /// DAY | BOARDING — persisted so the UI can display and filter by boarding status
  boardingStatus           String?
  dateOfBirth              DateTime?
  classId                  String
  parentName               String?
  parentContact            String?
  /// Optional URL to the student's profile photo (Supabase Storage public URL)
  photoUrl                 String?
  /// Raw Supabase Storage path for the student's photo (images bucket).
  /// Used for deletes/replacements without parsing the URL.
  photoStoragePath         String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  schoolId                 String
  /// Lifecycle management: when a student is removed from active list
  archivedAt               DateTime?
  /// TRANSFER, EXPULSION, or GRADUATION
  archiveType              String?
  /// Free-text reason for Transfer/Expulsion, stored here for quick access
  archiveReason            String?
  /// User who performed the archive action
  archivedById             String?
  attendances              Attendance[]
  /// Assessment framework back-relations
  assessmentItems          AssessmentItem[]
  reportRemarks            ReportRemark[]
  schoolClass              SchoolClass          @relation(fields: [classId], references: [id])
  school                   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                     User?                @relation(fields: [userId], references: [id])
  archivedBy               User?                @relation("StudentArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  electives                StudentElective[]
  disciplineRecords        DisciplineRecord[]
  achievements             AchievementStudent[]
  files                    StudentFile[]
  libraryCard              LibraryCard?
  groupMemberships         GroupMember[]
  /// Accommodation back-relations
  accommodationAllocations AllocationRecord[]
  dormCaptainOf            Dormitory[]          @relation("DormCaptain")
  accommodationEvents      AccommodationEvent[]
  /// Fees & Ledger back-relations
  financeAccount           StudentFinanceAccount?
  ledgerEntries            LedgerEntry[]
  invoices                 Invoice[]
  payments                 Payment[]
  expenseAttachments       StudentExpenseAttachment[]
  debtorFlags              DebtorFlag[]
  financeNotifications     FinanceNotification[]

  @@unique([schoolId, admissionNumber])
  @@index([classId])
  @@index([schoolId])
  /// Supports full-name search: WHERE schoolId=? AND fullName ILIKE ?
  @@index([schoolId, fullName])
  /// Supports admission-number search and the max-admission-number query.
  @@index([schoolId, admissionNumber])
  /// History module queries
  @@index([schoolId, archivedAt])
  @@index([schoolId, classId, archivedAt])
}

/// Section 4B — elective subject selections, distinct from core subjects
/// (core subjects apply to a student automatically via Subject.applicableForms).
model StudentElective {
  studentId String
  subjectId String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
}

/// Section 2C — the weekly timetable grid. dayOfWeek: 0=Mon..4=Fri, period:
/// 1-based lesson slot in the day. Two unique constraints do the heavy lifting:
/// a class can't have two subjects in the same slot (class_slot), and a teacher
/// can't be double-booked for the same class at the same time (teacher_class_slot).
/// The teacher constraint now includes classId so that a teacher legitimately
/// running a pooled/merged group session for two different classes at the same
/// period can have two rows (one per class) without triggering a violation.
/// classId and teacherId are already school-scoped, so schoolId is not needed in
/// the constraints — but is kept for cheap school-wide queries without a join.
model TimetableSlot {
  id          String      @id @default(cuid())
  classId     String
  dayOfWeek   Int
  period      Int
  subjectId   String
  teacherId   String
  room        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  schoolId    String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id])
  teacher     Teacher     @relation(fields: [teacherId], references: [id])

  @@unique([classId, dayOfWeek, period], name: "class_slot")
  /// Prevents the same teacher being booked for the same class twice at the same
  /// time. classId is intentionally included so a teacher can cover two different
  /// classes in the same period (pooled/merged elective group session).
  @@unique([classId, teacherId, dayOfWeek, period], name: "teacher_class_slot")
  @@index([schoolId])
}

/// Section: Timetable Configuration. The school-day structure and template
/// that defines what the timetable looks like — one row per school.
model TimetableConfig {
  schoolId                   String                    @id
  /// Academic year this config applies to, e.g. "2026"
  academicYear               String?
  /// Which term (1, 2, or 3)
  term                       Int?
  /// Operating days of the week, e.g. [0,1,2,3,4] for Mon-Fri
  operatingDays              Int[]                     @default([0, 1, 2, 3, 4])
  /// Maximum lessons a teacher can teach per day
  maxLessonsPerTeacherPerDay Int                       @default(6)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  school                     School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// The template columns that define the timetable format
  columns                    TimetableTemplateColumn[]
  /// Natural language scheduling preferences translated to constraints
  preferences                TimetablePreference[]
}

/// One column in the timetable template — can be a lesson slot or non-lesson
/// period (break, lunch, games, assembly). Admins configure this once and
/// every class follows the same format.
model TimetableTemplateColumn {
  id        String            @id @default(cuid())
  configId  String
  /// Display order (1-indexed)
  position  Int
  /// Start time, e.g. "08:00" (24-hour)
  startTime String
  /// End time, e.g. "08:40"
  endTime   String
  /// LESSON | BREAK | LUNCH | GAMES | ASSEMBLY
  slotType  TimetableSlotType @default(LESSON)
  /// Human label for non-lesson slots, e.g. "Morning Break" or "Lunch"
  label     String?
  /// Which session this belongs to: MORNING | AFTERNOON | EVENING
  session   TimetableSession  @default(MORNING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  config    TimetableConfig   @relation(fields: [configId], references: [schoolId], onDelete: Cascade)

  @@unique([configId, position])
  @@index([configId])
}

/// How many lessons per week a specific class needs for a specific subject.
/// Requirements differ per class/stream since 8-4-4, CBC, and CBE have
/// different lesson counts. One row per (subject, class) pair.
model SubjectLessonRequirement {
  id             String      @id @default(cuid())
  schoolId       String
  subjectId      String
  classId        String
  /// Number of lessons required per week for this class
  lessonsPerWeek Int         @default(5)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class          SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([subjectId, classId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([classId])
}

/// Per-class subject type override. When a subject is ELECTIVE globally but
/// should be treated as CORE for a specific class (or vice-versa), a row is
/// created here. Absence of a row means the subject's global type applies.
/// One row per (class, subject) pair, scoped to a school.
model ClassSubjectProfile {
  id        String      @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  /// The type this subject takes within this specific class
  type      SubjectType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId], name: "classId_subjectId")
  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

/// AI-translated natural language preferences stored as structured constraints
/// that the deterministic engine reads. AI only translates, never generates
/// the timetable itself.
model TimetablePreference {
  id               String            @id @default(cuid())
  configId         String
  /// The original natural language instruction, e.g. "Maths should be in the morning"
  instruction      String
  /// Which subject this applies to (null = school-wide preference)
  subjectCode      String?
  /// Which session to prefer: MORNING | AFTERNOON | EVENING | null
  preferredSession TimetableSession?
  /// Whether this is a hard constraint (must satisfy) or soft (nice to have)
  isHard           Boolean           @default(false)
  /// JSON blob with additional constraint details if needed
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  config           TimetableConfig   @relation(fields: [configId], references: [schoolId], onDelete: Cascade)

  @@index([configId])
}

/// Enum: What type of period a template column represents
enum TimetableSlotType {
  LESSON
  BREAK
  LUNCH
  GAMES
  ASSEMBLY
}

/// Enum: Teaching day divisions
enum TimetableSession {
  MORNING
  AFTERNOON
  EVENING
}

/// Lifecycle status of a versioned timetable draft
enum TimetableVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Audit log action types for timetable changes
enum TimetableChangeAction {
  GENERATED
  PUBLISHED
  ARCHIVED
  SLOT_EDITED
  SLOT_LOCKED
  SLOT_UNLOCKED
  CLONED
  DELETED
}

/// A versioned snapshot of a generated timetable. The engine always writes
/// to a DRAFT version; a PRINCIPAL can promote a draft to PUBLISHED.
/// Only one version per school can be PUBLISHED at a time.
model TimetableVersion {
  id              String                 @id @default(cuid())
  schoolId        String
  name            String
  description     String?
  status          TimetableVersionStatus @default(DRAFT)
  academicYear    String?
  term            Int?
  clonedFromId    String?
  generatedAt     DateTime?
  publishedAt     DateTime?
  publishedById   String?
  createdById     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  /// Snapshot of all vulnerabilities (conflicts + staff shortages) captured at
  /// generation or last validation. Stored as JSON so clicking a version in the
  /// UI shows exactly what issues were present at that point in time.
  vulnerabilities Json?
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots           TimetableVersionSlot[]
  changeLogs      TimetableChangeLog[]

  @@index([schoolId])
  @@index([schoolId, status])
}

/// One scheduled lesson within a versioned timetable. Each slot records
/// which teacher covers which subject for a given class at a specific
/// day/period. isManual=true means a human overrode an engine-generated slot.
model TimetableVersionSlot {
  id          String           @id @default(cuid())
  versionId   String
  schoolId    String
  classId     String
  dayOfWeek   Int
  period      Int
  subjectId   String
  teacherId   String
  room        String?
  isManual    Boolean          @default(false)
  notes       String?
  isLocked    Boolean          @default(false)
  lockScope   String?
  lockedAt    DateTime?
  lockedById  String?
  lockReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Prevent the same teacher being booked for the same class twice at the same
  // slot. classId is intentionally part of the key: a teacher can legitimately
  // appear in two rows at the same (versionId, teacherId, dayOfWeek, period) when
  // they are running a pooled/merged elective group session for two different
  // classes simultaneously — each class gets its own row, and those rows are
  // distinguished by classId. The old constraint (without classId) silently
  // dropped the second class's row via ON CONFLICT DO NOTHING, causing data loss.
  @@unique([versionId, classId, teacherId, dayOfWeek, period], name: "TimetableVersionSlot_teacher_class_slot_key")
  @@index([versionId])
  @@index([schoolId])
  @@index([versionId, classId, dayOfWeek, period]) // Index for queries, but not unique
  @@index([classId])
  @@index([teacherId])
  @@index([versionId, isLocked])
}

/// Audit trail for every change made to a timetable version — generation,
/// manual edits, slot locks, publishing, and archiving.
model TimetableChangeLog {
  id            String                @id @default(cuid())
  schoolId      String
  versionId     String?
  action        TimetableChangeAction
  detail        Json                  @default("{}")
  performedById String?
  performedAt   DateTime              @default(now())
  changeSource  String?
  slotId        String?
  beforeState   Json?
  afterState    Json?
  reason        String?
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version       TimetableVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([versionId])
}

/// Section: 2C — the standing teacher assignment for one (class, subject) pair.
/// This is what makes a teacher "continue to be the teacher of that subject
/// to that class until changed": once a row exists, it never changes unless
/// the Principal explicitly updates it, giving timetable generation stable
/// teacher-to-stream assignments.
model ClassSubjectTeacher {
  classId     String
  subjectId   String
  teacherId   String
  updatedAt   DateTime    @updatedAt
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@index([teacherId])
}

/// Teacher availability constraints — slots where a teacher can't be scheduled.
/// E.g., part-time teachers who leave after period 5 on Fridays.
model TeacherUnavailability {
  id        String  @id @default(cuid())
  teacherId String
  dayOfWeek Int
  period    Int
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, period])
  @@index([teacherId])
}

/// An elective group (e.g. "GPC") that bundles several elective subjects into
/// one atomic timetable slot. Scoped to a form (scopeForm > 0) or
/// school-wide (scopeForm = 0). When scopeForm > 0, scopeStreams optionally
/// narrows the group to specific stream names (e.g. ["North", "East"]); an
/// empty array means the group applies to ALL streams of that form. Every
/// class in scope lands in the same period(s). Teacher assignments per subject
/// are stored in ElectiveGroupTeacher rather than in ClassSubjectTeacher.
model ElectiveGroup {
  id             String                 @id @default(cuid())
  schoolId       String
  name           String
  /// 0 = school-wide; any positive integer = the form number (e.g. 4).
  scopeForm      Int                    @default(0)
  /// Specific stream names this group applies to within scopeForm.
  /// Empty array = all streams in the form.
  scopeStreams   String[]               @default([])
  lessonsPerWeek Int                    @default(1)
  /// How many of those lessons per week should be scheduled as consecutive
  /// double-lesson blocks (0 = all singles, 1 = one double block, etc.).
  /// Mirrors the doublesPerWeek concept used for individual subjects in
  /// SubjectLessonRequirement and the requirements UI.
  doublesPerWeek Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members        ElectiveGroupMember[]
  teachers       ElectiveGroupTeacher[]
  classTeachers  ClassElectiveGroupTeacher[]

  /// Two groups with the same name can exist on different forms.
  @@unique([schoolId, name, scopeForm])
  @@index([schoolId])
  @@index([schoolId, scopeForm])
}

/// One subject inside an elective group. A subject may appear in more than
/// one group (for different scopes) — each membership is fully independent.
model ElectiveGroupMember {
  id        String        @id @default(cuid())
  groupId   String
  subjectId String
  createdAt DateTime      @default(now())
  group     ElectiveGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([groupId, subjectId])
  @@index([groupId])
  @@index([subjectId])
}

/// One teacher–subject pairing within an elective group. A single subject in
/// a group can have multiple rows if different teachers take sub-groups of
/// students (e.g. different elective combinations). Each row represents a
/// distinct sub-group that the class profile reads through and displays as a
/// separate row. This replaces per-class ClassSubjectTeacher rows for elective
/// subjects that belong to a group.
model ElectiveGroupTeacher {
  id        String        @id @default(cuid())
  groupId   String
  subjectId String
  teacherId String
  schoolId  String
  createdAt DateTime      @default(now())
  group     ElectiveGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// A teacher can only be assigned once per (group, subject) pair.
  @@unique([groupId, subjectId, teacherId])
  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([schoolId])
}

/// Per-class teacher–subject pairing within an elective group.
/// Whereas ElectiveGroupTeacher is form-wide (shared across all classes in a
/// form's group), this model is class-scoped: each stream/class assigns its
/// own teachers for each subject inside the group it belongs to. A single
/// subject in a group can have multiple rows for the same class if different
/// students in that class have different teachers (e.g. two Geography teachers
/// covering the same GPC group in the same class). Each row = one distinct
/// sub-group of students. The timetable engine and teacher dashboard read
/// these rows — not ClassSubjectTeacher — for elective subjects that are part
/// of a group.
model ClassElectiveGroupTeacher {
  id        String        @id @default(cuid())
  groupId   String
  classId   String
  subjectId String
  teacherId String
  schoolId  String
  createdAt DateTime      @default(now())
  group     ElectiveGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// A teacher can only be assigned once per (group, class, subject) triple.
  @@unique([groupId, classId, subjectId, teacherId])
  @@index([groupId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([schoolId])
}

/// Section: School Calendar. One row per school-specific calendar entry —
/// e.g. a mid-term break, a PTA meeting, or an exam sitting reminder. Kenya's
/// national public holidays are NOT stored here; they're computed on the fly
/// (see src/lib/kenyaHolidays.ts) and merged in by the calendar API so the
/// list stays correct year to year without any seeding or upkeep. `date` is
/// stored as a date-only value (midnight UTC of that calendar day) since
/// events in this system are day-granular, not time-of-day granular.
model CalendarEvent {
  id          String           @id @default(cuid())
  schoolId    String
  title       String
  description String?
  date        DateTime
  type        EventType        @default(EVENT)
  /// Who can see this event: EVERYONE (all authenticated users), STAFF_ONLY
  /// (teachers + ADMIN_STAFF + PRINCIPAL), or PARENTS_ONLY (parent portal).
  audience    CalendarAudience @default(EVERYONE)
  openingDate DateTime?
  closingDate DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, date])
  @@index([schoolId, audience])
}

/// Section: Attendance. One row per student per class per day — the
/// (studentId, classId, date) unique constraint is what makes taking
/// attendance twice for the same day an upsert (edit/reopen) instead of a
/// duplicate row, and is also what "one record per student per day" (Step 4)
/// means concretely. classId is kept alongside studentId (rather than
/// derived solely from Student.classId) so a student's attendance history
/// stays correctly attributed to the class they were actually in on that
/// day, even if they change class/stream later in the year.
model Attendance {
  id           String           @id @default(cuid())
  schoolId     String
  studentId    String
  classId      String
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy   Teacher?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, classId, date])
  @@index([schoolId, date])
  @@index([classId, date])
  /// Supports student attendance-history query: WHERE studentId=? ORDER BY date DESC.
  @@index([studentId, date])
  @@index([schoolId, date, status])
  @@index([schoolId, classId, date])
}

/// Records Module — one discipline case per row. Notes, events, and files
/// hang off this. classId snapshots the student's class at the time of the
/// offence (same rationale as Attendance.classId).
model DisciplineRecord {
  id            String            @id @default(cuid())
  schoolId      String
  studentId     String
  classId       String?
  offence       String
  description   String?
  actionTaken   String?
  resolution    String?
  dateOfOffence DateTime
  status        DisciplineStatus  @default(OPEN)
  notes         String?
  aiSummary     String?
  recordedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy    User?             @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  caseNotes     DisciplineNote[]
  events        DisciplineEvent[]
  files         StudentFile[]

  @@index([schoolId, dateOfOffence])
  @@index([studentId, dateOfOffence])
  /// Supports student-scoped discipline record listing.
  @@index([schoolId, studentId])
  @@index([schoolId, status])
}

/// A dated note added to a discipline case by staff.
model DisciplineNote {
  id                 String           @id @default(cuid())
  disciplineRecordId String
  body               String
  createdById        String?
  createdAt          DateTime         @default(now())
  disciplineRecord   DisciplineRecord @relation(fields: [disciplineRecordId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([disciplineRecordId])
}

/// Case history / timeline entry — written automatically on create, status
/// change, note added, file attached, etc.
model DisciplineEvent {
  id                 String           @id @default(cuid())
  disciplineRecordId String
  type               String
  detail             String
  createdById        String?
  createdAt          DateTime         @default(now())
  disciplineRecord   DisciplineRecord @relation(fields: [disciplineRecordId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([disciplineRecordId, createdAt])
}

/// File attached to a student (and optionally to a discipline case). Bytes
/// live in the DB — no external object store is configured for this system.
/// sha256 is unique per student to prevent duplicate uploads.
model StudentFile {
  id                 String            @id @default(cuid())
  schoolId           String
  studentId          String
  disciplineRecordId String?
  fileName           String
  mimeType           String
  size               Int
  sha256             String
  data               Bytes
  uploadedById       String?
  createdAt          DateTime          @default(now())
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  disciplineRecord   DisciplineRecord? @relation(fields: [disciplineRecordId], references: [id], onDelete: SetNull)
  uploadedBy         User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([studentId, sha256])
  @@index([schoolId])
  @@index([studentId])
  @@index([disciplineRecordId])
}

/// One achievement record, linkable to multiple students via
/// AchievementStudent — editing the record updates it for all linked
/// students at once.
model Achievement {
  id              String               @id @default(cuid())
  schoolId        String
  title           String
  category        AchievementCategory  @default(OTHER)
  description     String?
  achievementDate DateTime
  awardLevel      String?
  aiSummary       String?
  recordedById    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy      User?                @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  students        AchievementStudent[]

  @@index([schoolId, achievementDate])
}

/// Join table: which students share an achievement.
model AchievementStudent {
  achievementId String
  studentId     String
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([achievementId, studentId])
  @@index([studentId])
}

// =============================================================================
// Library Management System (v2 — Enterprise Grade)
// =============================================================================
//
// Design decisions:
//
//  1. LibrarySettings is expanded with identification method config,
//     eligible-student threshold, card expiry policy, and QR/barcode flags.
//
//  2. LibraryCatalogue is the shared "book record" (title + edition + form).
//     Multiple physical copies share one catalogue row, preventing duplicate
//     catalogue entries for the same edition.
//
//  3. LibraryCopy is the physical unit — every copy gets its own accession
//     number, QR code, barcode, condition history, and lifecycle state.
//     Copies are never permanently deleted; they transition to ARCHIVED or LOST.
//
//  4. LibraryCard is expanded with status (ACTIVE/SUSPENDED/ALUMNI/TRANSFERRED),
//     card number, expiry date, and photo URL so the card can be rendered as
//     a proper digital ID.
//
//  5. LibraryBorrow gains a copyId FK (pointing to the specific physical copy
//     issued) and a renewalCount to support renewals.
//
//  6. The legacy LibraryBook model is retained untouched for backward compat
//     with existing API routes and sync engine during migration.
//
// =============================================================================

/// Per-school library configuration — one row per school.
model LibrarySettings {
  schoolId             String             @id
  /// Maximum number of books a student may borrow at once.
  maxBooksPerStudent   Int                @default(3)
  /// Maximum number of days a student can keep a borrowed book.
  maxBorrowDays        Int                @default(14)
  /// Fine charged per day the book is overdue (in school currency units).
  finePerDay           Float              @default(5.0)
  /// Maximum renewals allowed per borrow.
  maxRenewals          Int                @default(1)
  /// How the librarian identifies a student or book during circulation.
  /// "MANUAL" = type admission number/book number; "QR_CAMERA" = device camera;
  /// "QR_HARDWARE" = USB/Bluetooth scanner auto-detected.
  identificationMethod LibraryIdentMethod @default(MANUAL)
  /// Whether barcode scanning is enabled in addition to QR codes.
  barcodeEnabled       Boolean            @default(false)
  /// When set, only students enrolled in forms >= this value are eligible.
  /// NULL = all enrolled students are eligible.
  eligibleFromForm     Int?
  /// Number of days a library card is valid for. NULL = no expiry.
  cardValidityDays     Int?
  /// Minimum overdue days before a student is flagged in reports.
  overdueAlertDays     Int                @default(7)
  updatedAt            DateTime           @updatedAt
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// Shared catalogue record — one row per unique (title, edition, form/class).
/// Multiple physical copies share this record.
model LibraryCatalogue {
  id                String                    @id @default(cuid())
  schoolId          String
  /// Book title
  title             String
  /// Book number — school-assigned identifier, e.g. "MAT-001"
  bookNumber        String?
  /// Subject this book covers, e.g. "Mathematics"
  subject           String?
  /// Human-readable level/grade descriptor, e.g. "Form 3", "Grade 7", "Junior Secondary"
  level             String?
  /// Form/class level, e.g. 3 for Form 3
  form              Int?
  author            String?
  publisher         String?
  /// Edition number, e.g. "3rd Edition"
  edition           String?
  isbn              String?
  category          LibraryCategory           @default(TEXTBOOK)
  /// Physical location label, e.g. "A", "Science"
  shelf             String?
  /// Row within shelf, e.g. "Row 2"
  shelfRow          String?
  language          String                    @default("English")
  publishYear       Int?
  /// Purchase date of this catalogue entry (latest acquisition)
  purchaseDate      DateTime?
  /// Cost per copy in school currency
  costPerCopy       Float?
  /// Total copies owned (maintained as a computed count via application layer)
  totalCopies       Int                       @default(0)
  /// Whether this catalogue record is archived (no new copies can be added)
  archivedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copies            LibraryCopy[]
  reservations      LibraryReservation[]
  classroomLoans    LibraryClassroomLoan[]
  circulationEvents LibraryCirculationEvent[]

  @@unique([schoolId, bookNumber], name: "school_bookNumber")
  @@index([schoolId])
  @@index([schoolId, subject])
  @@index([schoolId, form])
  @@index([schoolId, category])
  @@index([schoolId, shelf])
  @@index([schoolId, title])
}

/// One physical copy of a catalogue entry. Tracked from acquisition to retirement.
model LibraryCopy {
  id              String               @id @default(cuid())
  schoolId        String
  catalogueId     String
  /// Unique accession number assigned when the copy is registered, e.g. "ACC-00145"
  accessionNumber String
  /// Human-readable physical sticker number, school-scoped sequential, e.g. "BK-00001".
  /// Never reused — even after withdrawal. Used on physical sticker labels alongside QR.
  bookNumber      String?
  /// QR code payload — typically the accession number or a URL (legacy plain-text)
  qrCode          String?              @unique
  /// Signed QR token: base64url(payload).base64url(HMAC-SHA256 signature).
  /// Payload: { copy_id, school_id, issued_at }. Verified server-side on scan.
  qrToken         String?              @unique
  /// When the current qrToken was issued. Null until first token is generated.
  qrIssuedAt      DateTime?
  /// Barcode value (if barcodeEnabled)
  barcode         String?
  condition       LibraryCopyCondition @default(GOOD)
  /// Lifecycle state of this physical copy
  status          LibraryCopyStatus    @default(AVAILABLE)
  /// When this copy was acquired
  acquisitionDate DateTime?
  /// Cost of this specific copy
  cost            Float?
  /// When this copy was archived/removed from circulation
  archivedAt      DateTime?
  /// Reason for archiving (LOST, DAMAGED_BEYOND_REPAIR, DEACCESSION, etc.)
  archiveReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  catalogue       LibraryCatalogue     @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  borrows         LibraryBorrow[]

  @@unique([schoolId, accessionNumber], name: "school_accessionNumber")
  @@unique([schoolId, bookNumber],      name: "school_copyBookNumber")
  @@index([schoolId])
  @@index([catalogueId])
  @@index([schoolId, status])
}

/// Master catalogue of books — legacy model kept for backward compatibility.
/// New code should use LibraryCatalogue + LibraryCopy instead.
model LibraryBook {
  id            String          @id @default(cuid())
  schoolId      String
  title         String
  author        String?
  isbn          String?
  publisher     String?
  /// Year of publication, e.g. 2018
  publishYear   Int?
  /// How many physical copies the school owns
  totalCopies   Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  borrowRecords LibraryBorrow[]

  @@unique([schoolId, isbn], name: "school_isbn")
  @@index([schoolId])
}

/// A student's digital library card — one row per student, auto-created when
/// the student is enrolled (or on first interaction). Expanded with status,
/// card number, and expiry for proper digital ID rendering.
model LibraryCard {
  id                 String            @id @default(cuid())
  schoolId           String
  studentId          String            @unique
  /// Unique human-readable card number, e.g. "LIB-2024-00042"
  cardNumber         String?
  /// Card status — automatically set by lifecycle events
  status             LibraryCardStatus @default(ACTIVE)
  /// When non-null, card is suspended with this reason
  suspensionReason   String?
  /// Card expiry date — derived from LibrarySettings.cardValidityDays at issue time
  expiresAt          DateTime?
  /// Accumulated unpaid fines in school currency units.
  fineBalance        Float             @default(0)
  /// Total fines ever paid — used for the principal's paid-fines widget.
  totalFinesPaid     Float             @default(0)
  /// Count of books currently borrowed (cached for performance)
  currentBorrowCount Int               @default(0)
  /// Total books ever borrowed
  totalBorrowCount   Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  borrows            LibraryBorrow[]

  @@index([schoolId])
  @@index([schoolId, status])
}

/// One borrow event: a student checked out one copy of one book.
/// returnedAt is null while the book is still out.
model LibraryBorrow {
  id              String       @id @default(cuid())
  schoolId        String
  cardId          String
  /// Legacy FK — points to LibraryBook (used by old borrow routes)
  bookId          String?
  /// New FK — points to the specific LibraryCopy issued (preferred)
  copyId          String?
  borrowedAt      DateTime     @default(now())
  dueAt           DateTime
  /// Set when the book is physically returned.
  returnedAt      DateTime?
  /// When non-null, fine accrual has been manually stopped by the librarian.
  fineStoppedAt   DateTime?
  /// Final fine charged for this borrow (computed on return / fine-stop).
  fineAmount      Float        @default(0)
  /// Number of times this borrow has been renewed
  renewalCount    Int          @default(0)
  /// Notes added by librarian at return or during the borrow period
  notes           String?
  /// Condition of the book on return: EXCELLENT | GOOD | FAIR | DAMAGED | LOST
  returnCondition String?
  /// Return type: NORMAL | DAMAGED | LOST | REPLACEMENT_RECEIVED
  returnType      String?
  /// Whether this borrow was processed with a manual override
  isOverride      Boolean      @default(false)
  /// Reason for override (required when isOverride = true)
  overrideReason  String?
  /// User who authorized the override
  overrideById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  card            LibraryCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  book            LibraryBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  copy            LibraryCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([cardId])
  @@index([bookId])
  @@index([schoolId, returnedAt])
  @@index([schoolId, returnedAt, dueAt])
}

// =============================================================================
// Library Stage 2 — Policies, Reservations, Fine Audit, Circulation Events
// =============================================================================

/// Configurable per-patron-type circulation policy. Each school can define
/// different rules for STUDENT, TEACHER, BOARDING, DAY_SCHOLAR, JUNIOR, SENIOR.
/// A single DEFAULT row covers all patron types unless overridden.
model LibraryPolicy {
  id                  String            @id @default(cuid())
  schoolId            String
  /// Patron category this policy applies to. DEFAULT covers all.
  patronType          LibraryPatronType @default(DEFAULT)
  /// Human label, e.g. "Boarding Students"
  label               String?
  /// Max books allowed out simultaneously
  maxBooksAllowed     Int               @default(3)
  /// Default borrow period in days
  borrowDays          Int               @default(14)
  /// Grace period (days) before fines start accruing
  gracePeriodDays     Int               @default(0)
  /// Daily fine rate (school currency)
  finePerDay          Float             @default(5.0)
  /// Count weekends toward overdue calculation
  countWeekends       Boolean           @default(true)
  /// Count public holidays toward overdue
  countHolidays       Boolean           @default(false)
  /// Max renewals per borrow
  maxRenewals         Int               @default(1)
  /// Fine threshold (KES) above which borrowing is blocked; 0 = any fine blocks
  fineBlockThreshold  Float             @default(0)
  /// Replacement cost multiplier when book is declared lost (× costPerCopy)
  lostBookMultiplier  Float             @default(1.0)
  /// Fixed replacement fee when lost book cost is unknown
  lostBookFixedFee    Float             @default(500)
  /// Fine rate for damaged books (% of costPerCopy)
  damagedBookFineRate Float             @default(0.3)
  /// Whether reservations are allowed for this patron type
  reservationsAllowed Boolean           @default(true)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, patronType])
  @@index([schoolId])
}

/// Permanent audit record for every fine adjustment, clearance, or override.
/// Never deleted — immutable history.
model LibraryFineAudit {
  id            String   @id @default(cuid())
  schoolId      String
  cardId        String
  borrowId      String?
  /// CHARGE | PAYMENT | CLEAR | OVERRIDE | PAUSE_APPLIED | PAUSE_REMOVED
  eventType     String
  /// Amount affected (positive = charge, negative = credit)
  amount        Float    @default(0)
  /// Balance after this event
  balanceAfter  Float    @default(0)
  /// Mandatory reason for CLEAR or OVERRIDE actions
  reason        String?
  /// User who performed the action
  performedById String?
  createdAt     DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([cardId])
  @@index([borrowId])
}

/// A period during which fine accumulation is paused school-wide, or for
/// individual students / exam periods / holidays / events.
model LibraryFinePause {
  id          String    @id @default(cuid())
  schoolId    String
  /// SCHOOL_WIDE | STUDENT | EXAM_PERIOD | HOLIDAY | SPECIAL_EVENT
  scope       String    @default("SCHOOL_WIDE")
  /// Only set when scope = STUDENT
  studentId   String?
  label       String
  reason      String?
  startDate   DateTime
  endDate     DateTime?
  /// Whether this pause is currently active
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, isActive])
}

/// A reservation request: a patron wants a specific catalogue entry.
/// When a copy becomes available it is automatically allocated here.
model LibraryReservation {
  id                 String                   @id @default(cuid())
  schoolId           String
  catalogueId        String
  /// TYPE: INDIVIDUAL | CLASSROOM | DEPARTMENT | WAITLIST
  reservationType    LibraryReservationType   @default(INDIVIDUAL)
  /// Student patron (for INDIVIDUAL + WAITLIST)
  studentId          String?
  /// Teacher patron (for CLASSROOM reservations)
  teacherId          String?
  /// Department name (for DEPARTMENT reservations)
  departmentName     String?
  /// For classroom: expected return date (may be after academic year)
  expectedReturnDate DateTime?
  /// For classroom: max copies reserved
  quantityRequested  Int                      @default(1)
  /// Notes from teacher/librarian
  notes              String?
  /// Status: PENDING | ACTIVE | FULFILLED | CANCELLED | EXPIRED
  status             LibraryReservationStatus @default(PENDING)
  /// Which specific copy was allocated (set when status → ACTIVE)
  allocatedCopyId    String?
  /// When the reservation was fulfilled / copy collected
  fulfilledAt        DateTime?
  /// When the reservation expires (auto-calculated from settings)
  expiresAt          DateTime?
  /// Position in waitlist queue (1-indexed)
  queuePosition      Int?
  createdById        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  catalogue          LibraryCatalogue         @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([catalogueId])
  @@index([studentId])
  @@index([schoolId, status])
}

/// A classroom loan — a teacher takes copies for class use. Individual copy
/// assignments (which student has which copy) can be tracked via notes or
/// a separate future model. Returns are teacher-driven and may span terms.
model LibraryClassroomLoan {
  id                 String           @id @default(cuid())
  schoolId           String
  catalogueId        String
  teacherId          String
  classId            String?
  copiesCount        Int              @default(1)
  borrowedAt         DateTime         @default(now())
  /// Teacher-specified return date
  expectedReturnDate DateTime?
  returnedAt         DateTime?
  notes              String?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  catalogue          LibraryCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([catalogueId])
  @@index([teacherId])
}

/// Immutable event log for every circulation action on a physical copy.
/// Provides lifetime intelligence — every borrower, every condition change,
/// every reservation, every fine event — for analytics and audit.
model LibraryCirculationEvent {
  id            String            @id @default(cuid())
  schoolId      String
  copyId        String?
  catalogueId   String?
  borrowId      String?
  reservationId String?
  /// BORROWED | RETURNED | RENEWED | RESERVED | RESERVATION_CANCELLED |
  /// CONDITION_CHANGED | LOST_REPORTED | REPLACEMENT_RECEIVED |
  /// FINE_CHARGED | FINE_CLEARED | FINE_PAUSED | ARCHIVED
  eventType     String
  /// Snapshot of relevant data at event time (JSON)
  payload       Json?
  performedById String?
  studentId     String?
  teacherId     String?
  createdAt     DateTime          @default(now())
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  catalogue     LibraryCatalogue? @relation(fields: [catalogueId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([copyId])
  @@index([catalogueId])
  @@index([studentId])
  @@index([schoolId, eventType])
}

// =============================================================================
// Library Stage 2 enums
// =============================================================================

enum LibraryPatronType {
  DEFAULT
  STUDENT
  TEACHER
  BOARDING
  DAY_SCHOLAR
