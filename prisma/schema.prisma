// =============================================================================
// Supabase Storage metadata — file records
// =============================================================================
//
// We never store file bytes in Postgres. These models store only the
// Supabase Storage path + metadata. Signed URLs are generated on-demand
// from the path using the storage helpers in src/lib/supabase/storage.ts.
//
// Strict school isolation: every row carries schoolId so RLS policies and
// application-layer checks always scope reads/writes to one school.
// =============================================================================

/// Metadata for an image stored in the Supabase `images` bucket.
/// Covers profile avatars, school logos, stamps, and any other image asset.
model StoredImage {
  id            String   @id @default(cuid())
  schoolId      String
  /// Who owns this image (User.id). Null for school-level assets (logo, stamp).
  ownerId       String?
  /// Supabase Storage path, e.g. "{schoolId}/{userId}/{timestamp}.jpg"
  storagePath   String   @unique
  /// MIME type, e.g. "image/jpeg"
  mimeType      String   @default("image/jpeg")
  /// File size in bytes
  sizeBytes     Int?
  /// Human label, e.g. "Profile photo", "School logo"
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([ownerId])
  @@index([schoolId, ownerId])
}

/// Metadata for a PDF report stored in the Supabase `reports` bucket.
/// Reports are private — always accessed via short-lived signed URLs.
model StoredReport {
  id            String   @id @default(cuid())
  schoolId      String
  /// The user (student/teacher) this report belongs to, if applicable.
  subjectUserId String?
  /// Supabase Storage path, e.g. "{schoolId}/{reportId}.pdf"
  storagePath   String   @unique
  /// Human-readable report title, e.g. "Term 1 2026 Results — Jane Wanjiru"
  title         String
  /// Optional term / period label for quick filtering
  periodLabel   String?
  /// File size in bytes
  sizeBytes     Int?
  createdAt     DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([subjectUserId])
  @@index([schoolId, subjectUserId])
  @@index([schoolId, createdAt(sort: Desc)])
}

enum Role {
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  WATCHMAN
  MARKER
  ADMIN_STAFF
  BURSAR
  SUPER_ADMIN
}

// =============================================================================
// Super Admin Control Plane
// =============================================================================

/// Plan tiers available to schools. Determines which module bundle is
/// pre-enabled when the school is onboarded.
enum PlanTier {
  FREE
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

/// Lifecycle status of a school account.
enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

/// Cross-cutting system module registry — distinct from the per-school
/// Module enum (which governs staff RBAC). These are platform-level
/// feature flags toggled by the super admin.
enum SystemModule {
  ATTENDANCE
  GRADING
  FEE_MANAGEMENT
  LIBRARY
  TRANSPORT
  MESSAGING
  IMPORT_TOOL
  REPORTS
  TIMETABLE
  ACCOMMODATION
  ANALYTICS
  AI_TOOLS
}

/// Severity level for system errors reported across schools.
enum ErrorSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Triage status for an error entry.
enum ErrorStatus {
  NEW
  INVESTIGATING
  RESOLVED
  IGNORED
}

/// Processing status for a bulk import job.
enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

/// Type of data being imported.
enum ImportType {
  // ── Section 1: School Setup ──────────────────────────────────────────────
  DEPARTMENTS       /// Academic departments
  CLASSES           /// Classes with framework (8-4-4 / CBC / CBE)
  SUBJECTS          /// Subject catalogue linked to departments
  // ── Section 2: Staff ────────────────────────────────────────────────────
  STAFF             /// Staff details + subjects they teach
  // ── Section 3: Students ─────────────────────────────────────────────────
  STUDENTS          /// Student details + class + elective subjects
  STUDENT_DORM      /// Assign students to dormitories / sleeping positions
  // ── Section 4: Parents ──────────────────────────────────────────────────
  PARENTS           /// Parent / guardian details linked to students
  // ── Section 5: Finance ──────────────────────────────────────────────────
  STUDENT_OPENING_BALANCE  /// Seed the ledger with each student's current outstanding balance
  // ── Legacy / compatibility ───────────────────────────────────────────────
  BOTH
  CUSTOM
  DORM_SETUP    /// Dormitories + cubicles + beds in one file
  DORMITORIES   /// legacy
  BEDS          /// legacy
  ALLOCATIONS   /// legacy
}

/// Live service health status.
enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

/// Overall system health banner status.
enum SystemHealthStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
}

// ---------------------------------------------------------------------------
// Super-admin extended school metadata
// ---------------------------------------------------------------------------
// The core School model is owned by the school-facing app. We store
// super-admin-only fields in a separate 1:1 companion model so the existing
// school queries are unaffected.

/// Super-admin-only metadata attached to each school. One row per School.
model SchoolMeta {
  schoolId       String       @id
  planTier       PlanTier     @default(FREE)
  status         SchoolStatus @default(ONBOARDING)
  storageQuotaGb Float        @default(5)
  slug           String?      @unique
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  studentCount   Int          @default(0)
  staffCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([planTier])
}

/// One row per module enabled/disabled for a school.
model SchoolModuleToggle {
  schoolId  String
  module    SystemModule
  enabled   Boolean      @default(false)
  updatedBy String?      /// super_admin user id
  updatedAt DateTime     @updatedAt
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, module])
  @@index([schoolId])
}

/// Error/exception entries reported across all schools.
model SystemError {
  id          String        @id @default(cuid())
  schoolId    String?
  message     String
  stackTrace  String?
  severity    ErrorSeverity @default(MEDIUM)
  module      String?
  status      ErrorStatus   @default(NEW)
  occurrences Int           @default(1)
  /// Sanitised request context (no PII) stored as JSON
  context     Json?
  notes       String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

/// Per-service health & uptime tracking.
model ServiceHealth {
  id                String        @id @default(cuid())
  serviceName       String        @unique
  status            ServiceStatus @default(OPERATIONAL)
  uptimePct24h      Float         @default(100)
  uptimePct7d       Float         @default(100)
  uptimePct30d      Float         @default(100)
  lastIncidentAt    DateTime?
  lastCheckedAt     DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// Point-in-time metric snapshot per service.
model MetricSnapshot {
  id             String   @id @default(cuid())
  serviceName    String
  responseTimeMs Float?
  errorRate      Float?
  requestCount   Int?
  recordedAt     DateTime @default(now())

  @@index([serviceName, recordedAt])
}

/// Incident log entry — manually added or auto-created on downtime.
model IncidentLog {
  id          String    @id @default(cuid())
  title       String
  description String?
  serviceName String?
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdBy   String?   /// super_admin user id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}

/// Per-school storage usage snapshot.
model StorageUsage {
  id        String   @id @default(cuid())
  schoolId  String
  /// "documents" | "media" | "database" | "backups"
  type      String
  sizeBytes BigInt   @default(0)
  recordedAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, recordedAt])
  @@index([schoolId, type])
}

/// Bulk import job record.
model ImportJob {
  id           String       @id @default(cuid())
  schoolId     String
  type         ImportType
  fileName     String
  totalRows    Int          @default(0)
  succeeded    Int          @default(0)
  failed       Int          @default(0)
  status       ImportStatus @default(QUEUED)
  errorReport  Json?        /// array of per-row errors
  createdBy    String?      /// super_admin user id
  rollbackAt   DateTime?    /// deadline for rollback (createdAt + 24h)
  rolledBackAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
}

/// Immutable audit trail for all sensitive super-admin actions.
model SuperAdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   /// super_admin user id
  action     String   /// e.g. "SCHOOL_SUSPENDED", "MODULE_TOGGLED", "IMPERSONATION"
  targetType String?  /// "school" | "user" | "module" | "import"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

/// System-level health/status banner.
model SystemStatus {
  id        String             @id @default(cuid())
  status    SystemHealthStatus @default(OPERATIONAL)
  message   String?
  updatedBy String?
  updatedAt DateTime           @updatedAt
  createdAt DateTime           @default(now())
}

enum SubjectType {
  CORE
  ELECTIVE
}

/// Section: Staff Roles & Permissions (RBAC). Every screen/API surface a
/// non-Principal staff member could touch is one of these. Kept as an enum
/// (not free-text) so a typo in a permission row can never silently grant or
/// block access to something that doesn't exist.
enum Module {
  DEPARTMENTS
  SUBJECTS
  STAFF
  STAFF_ROLES
  CLASSES
  STUDENTS
  TIMETABLE
  EXAM_PERIODS
  RESULTS
  TOD
  COMMUNICATION
  CALENDAR
  AI_TOOLS
  REPORTS
  RECORDS
  RECORDS_DISCIPLINE
  RECORDS_ACHIEVEMENTS
  ANALYTICS
  /// Multi-framework assessment: framework config, sitting periods, and
  /// item entry. Split from the old EXAM_PERIODS / RESULTS pair so scoped
  /// roles (e.g. CBC class teacher, CBE assessor) can be granted
  /// independently of the legacy modules.
  ASSESSMENTS
  /// Assessment framework hierarchy management: learning areas, strands,
  /// papers, competency units. Typically HOD / Academic Deputy territory.
  ASSESSMENT_FRAMEWORK
  /// Library catalogue, student library cards, borrowing, and fines.
  LIBRARY
  /// Lifecycle history: graduated, transferred, and expelled students; transferred staff.
  HISTORY
  /// Accommodation module: dormitories, cubicles, beds, and student boarding allocations.
  ACCOMMODATION
  /// Attendance module: take and review daily class attendance. Principals
  /// always have this. Granting it to a staff role lets any admin-staff member
  /// take or review attendance across all classes.
  ATTENDANCE
  /// Finance/Fees module — full access for Bursar; read-only analytics for Principal
  FEES
}

/// Every third-party service a school can bring its own credentials for.
/// Deliberately an enum (not free text) — the settings screen, the
/// encryption layer, and whatever service code eventually calls Gemini/SMS/
/// etc. all key off the same fixed list, so a typo can't silently create an
/// unused row or fail to find a configured one.
enum IntegrationProvider {
  GEMINI
  GOOGLE_CALENDAR
  SMS
  WHATSAPP
  EMAIL
  MPESA_DARAJA
}

/// Section: School Calendar. HOLIDAY here is a school-declared holiday
/// (e.g. a local closure), distinct from the computed Kenya public holidays
/// the calendar API merges in separately.
enum EventType {
  HOLIDAY
  EXAM
  MEETING
  EVENT
  OTHER
}

/// Controls which user groups can see a calendar event.
enum CalendarAudience {
  EVERYONE
  STAFF_ONLY
  PARENTS_ONLY
}

/// Section: Attendance. Two states only — attendance is taken with a
/// checkbox (checked = Present, unchecked = Absent). LATE/EXCUSED were
/// removed; the migration mapped LATE→PRESENT and EXCUSED→ABSENT.
enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ---------------------------------------------------------------------------
// Pathway weight configuration (Senior CBE)
// ---------------------------------------------------------------------------
// Stores the SBA/exam weighting split and maximum marks for each subject
// within a Senior CBE framework. Used by CbePathwayGrid to compute the
// weighted combined score. Unique per (framework, subject).

/// Configures the SBA-to-exam weighting for one subject in a Senior CBE
/// framework. If no row exists, the system defaults to 60/40 with maxMarks
/// of 100 for both components.
model PathwayWeight {
  id           String              @id @default(cuid())
  schoolId     String
  frameworkId  String
  subjectId    String
  /// Fraction of the final score from school-based assessment, e.g. 0.6.
  /// sbaWeight + examWeight must equal 1.0 (enforced by DB CHECK).
  sbaWeight    Float               @default(0.6)
  examWeight   Float               @default(0.4)
  sbaMaxMarks  Float               @default(100)
  examMaxMarks Float               @default(100)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework    AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, subjectId])
  @@index([schoolId])
}

// =============================================================================
// Subject-expectation configuration — how many subjects each form is expected
// to have enrolled (used by the analytics / reports layer to flag shortfalls).
// =============================================================================

/// Per-(school, form) configuration: how many subjects students in that form
/// are expected to be taking. One row per form level per school. Created/
/// updated via PUT /api/subject-expectations; defaults to 0 when absent.
model FormSubjectExpectation {
  id            String   @id @default(cuid())
  schoolId      String
  form          Int
  expectedCount Int      @default(0)
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, form], name: "schoolId_form")
  @@index([schoolId])
}

// =============================================================================
// ASSESSMENT FRAMEWORK — multi-framework assessment layer
// =============================================================================
//
// Design decisions:
//
//  1. FrameworkType is an enum, not free text, so downstream code can branch
//     on it safely without string matching.
//
//  2. Each framework type gets its own hierarchy tables rather than a single
//     self-referential "node" table. Self-referential trees are flexible but
//     make queries and constraints messy; fixed-depth tables let the DB
//     enforce "a SubStrand must have a Strand, a Strand must have a
//     LearningArea" without application-layer guards.
//
//  3. AssessmentItem is the single polymorphic record table. The three result
//     types (numeric / performance level / competency) are stored as three
//     nullable columns with a discriminator — exactly one is non-null per row.
//     A CHECK constraint in the migration enforces this. Prisma doesn't
//     generate CHECK constraints from the schema, so the migration SQL adds
//     them manually.
//
//  4. AssessmentRole is a scoped-RBAC join table: it grants a teacher a
//     specific role (e.g. SUBJECT_TEACHER, CLASS_TEACHER, HOD) for a
//     specific scope node (learningAreaId OR competencyUnitId OR subjectId)
//     within one school. This is intentionally separate from the existing
//     StaffRole/RolePermission system, which is module-level; assessment
//     roles are item-level.
//
//  5. AssessmentPeriod replaces ExamPeriod. It adds a frameworkId FK so
//     different frameworks can run concurrent sittings without collision.
//
// =============================================================================

/// Which curriculum framework a school (or a cohort within a school) uses.
enum FrameworkType {
  /// Kenya 8-4-4: numeric marks, KCSE grade bands, subject → paper structure.
  EIGHT_FOUR_FOUR
  /// CBC (Competency Based Curriculum): performance levels EE/ME/AE/BE,
  /// learning area → strand → sub-strand hierarchy.
  CBC
  /// CBE (Competency Based Education / TVET): competent / not-yet-competent,
  /// competency unit → element → performance criterion hierarchy.
  CBE
}

/// What kind of result payload an AssessmentItem carries.
/// Exactly one of the three nullable result columns on AssessmentItem is
/// populated — this discriminator makes that intent explicit and lets the
/// application branch cleanly.
enum AssessmentResultKind {
  /// A raw numeric mark (8-4-4). Stored in AssessmentItem.numericScore.
  NUMERIC
  /// CBC performance level: EE / ME / AE / BE.
  PERFORMANCE_LEVEL
  /// CBE competency status: COMPETENT or NOT_YET_COMPETENT.
  COMPETENCY_STATUS
}

/// CBC performance level rubric (KICD 2019 CBC framework).
enum PerformanceLevel {
  /// Exceeds Expectation
  EE
  /// Meets Expectation
  ME
  /// Approaches Expectation
  AE
  /// Below Expectation
  BE
}

/// CBE competency outcome — binary per performance criterion.
enum CompetencyStatus {
  COMPETENT
  NOT_YET_COMPETENT
}

/// One row per curriculum framework a school operates. Most schools will
/// have exactly one, but a school running both 8-4-4 (upper secondary) and
/// CBC (junior secondary) concurrently gets two rows. Scoped per school.
model AssessmentFramework {
  id              String             @id @default(cuid())
  schoolId        String
  type            FrameworkType
  /// Human-readable label, e.g. "KCSE 2026" or "CBC Grade 7".
  label           String
  /// Academic year this framework configuration applies to, e.g. "2026".
  academicYear    String
  /// Whether this is the active/default framework for new assessments.
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periods         AssessmentPeriod[]
  /// Framework-specific hierarchy back-relations
  papers          Paper[]
  learningAreas   LearningArea[]
  competencyUnits CompetencyUnit[]
  items           AssessmentItem[]
  roles           AssessmentRole[]
  pathwayWeights  PathwayWeight[]

  @@unique([schoolId, type, academicYear])
  @@index([schoolId])
}

/// A named assessment sitting scoped to one framework — replaces ExamPeriod.
/// Weight and maxMarks carry the same semantics as before but are now
/// framework-aware (CBC periods don't need maxMarks; CBE doesn't need
/// weight — both are nullable/defaulted so they can be ignored).
model AssessmentPeriod {
  id            String              @id @default(cuid())
  schoolId      String
  frameworkId   String
  name          String
  academicYear  String
  term          Int? /// 1, 2, or 3 for Kenyan terms
  /// Relative weight when combining periods (8-4-4 use case).
  weight        Float               @default(1)
  /// What numeric marks are out of (8-4-4 use case).
  maxMarks      Float?
  isCurrent     Boolean             @default(false)
  /// When marks entry opens (optional — informational only).
  openingDate   DateTime?
  /// Deadline for marks submission — shown as a countdown in teacher dashboards.
  closingDate   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework     AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  items         AssessmentItem[]
  reportRemarks ReportRemark[]

  @@unique([schoolId, frameworkId, name, academicYear])
  @@index([schoolId, frameworkId])
  /// Supports isCurrent=true lookup used by teacher home and sync pull.
  @@index([schoolId, isCurrent])
}

// ---------------------------------------------------------------------------
// 8-4-4 hierarchy: Subject → Paper
// ---------------------------------------------------------------------------
// The Subject model already exists (it is the subject list). Papers are the
// distinct marking units within a subject, e.g. Mathematics Paper 1 / Paper 2,
// English Paper 1 (Comprehension) / Paper 2 (Composition). A subject with no
// papers is assessed as a single unit (the subject itself acts as its own
// paper for results-entry purposes).

/// One paper within an 8-4-4 subject, e.g. "Mathematics Paper 1".
/// Scoped to both school and framework so the same subject can have
/// different paper splits across KCSE years if the syllabus changes.
model Paper {
  id          String              @id @default(cuid())
  schoolId    String
  frameworkId String
  subjectId   String
  name        String /// e.g. "Paper 1", "Paper 2 (Essay)"
  code        String? /// optional short code, e.g. "MAT1"
  /// Maximum marks for this paper. Overrides AssessmentPeriod.maxMarks for
  /// papers where the split is uneven (e.g. 40/60).
  maxMarks    Float               @default(100)
  /// Display order within the subject.
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework   AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  items       AssessmentItem[]

  @@unique([frameworkId, subjectId, name])
  @@index([schoolId, frameworkId])
  @@index([subjectId])
  /// Supports marksheet/report-card paper lookup: WHERE frameworkId=? AND subjectId=?
  @@index([frameworkId, subjectId])
}

/// HOD-configurable % formula override for a specific subject, form, and
/// assessment framework. When a marksheet loads for a matching
/// (subjectId, form, frameworkId) the stored formula is pre-loaded into the
/// FormulaCalculator instead of a blank default.
///
/// formula is a plain string using paper names, e.g.:
///   (Paper 1 / 80) * 40 + (Paper 2 / 100) * 60
/// An empty formula ("") means "use the raw score as-is" (default behaviour).
model DepartmentFormulaConfig {
  id           String   @id @default(cuid())
  schoolId     String
  departmentId String
  subjectId    String
  /// Form / year group this formula applies to, e.g. 3 or 4.
  form         Int
  frameworkId  String
  /// The formula expression, built with the marksheet calculator keyboard.
  formula      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// One formula per (subject, form, framework) in a department.
  @@unique([departmentId, subjectId, form, frameworkId])
  @@index([schoolId])
  @@index([departmentId])
  @@index([subjectId, form, frameworkId])
}

// ---------------------------------------------------------------------------
// CBC hierarchy: LearningArea → Strand → SubStrand
// ---------------------------------------------------------------------------
// Each level is scoped to (school, framework) so a school can customise
// names/codes without affecting other schools. The three-level hierarchy is
// fixed-depth by design (see design notes above).

/// Top-level CBC curriculum unit, e.g. "Mathematics", "English",
/// "Integrated Science". Analogous to a Subject in 8-4-4.
model LearningArea {
  id               String              @id @default(cuid())
  schoolId         String
  frameworkId      String
  name             String /// e.g. "Mathematics"
  code             String? /// e.g. "MATH"
  /// Grade levels this learning area applies to, e.g. [4, 5, 6, 7, 8, 9].
  applicableGrades Int[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework        AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  strands          Strand[]
  items            AssessmentItem[]
  roles            AssessmentRole[]

  @@unique([frameworkId, name])
  @@index([schoolId, frameworkId])
}

/// Second level: a thematic grouping within a Learning Area,
/// e.g. "Numbers" within Mathematics.
model Strand {
  id             String           @id @default(cuid())
  schoolId       String
  learningAreaId String
  name           String /// e.g. "Numbers"
  code           String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  learningArea   LearningArea     @relation(fields: [learningAreaId], references: [id], onDelete: Cascade)
  subStrands     SubStrand[]
  items          AssessmentItem[]

  @@unique([learningAreaId, name])
  @@index([schoolId])
  @@index([learningAreaId])
}

/// Third (leaf) level: the granular CBC assessment unit,
/// e.g. "Whole Numbers" within the Numbers strand of Mathematics.
model SubStrand {
  id        String           @id @default(cuid())
  schoolId  String
  strandId  String
  name      String /// e.g. "Whole Numbers"
  code      String?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  strand    Strand           @relation(fields: [strandId], references: [id], onDelete: Cascade)
  items     AssessmentItem[]

  @@unique([strandId, name])
  @@index([schoolId])
  @@index([strandId])
}

// ---------------------------------------------------------------------------
// CBE hierarchy: CompetencyUnit → CompetencyElement → PerformanceCriterion
// ---------------------------------------------------------------------------
// KNQA / TVET CBE structure. CompetencyUnit is the top-level qualification
// component (e.g. "Operate a Computer"); Elements break it into observable
// skills; PerformanceCriteria are the leaf-level evidence descriptors.

/// A named, assessable block of work-related competency, e.g.
/// "Operate a Computer" or "Apply Food Safety Practices".
model CompetencyUnit {
  id          String              @id @default(cuid())
  schoolId    String
  frameworkId String
  name        String
  code        String? /// KNQA unit code if applicable
  /// Credit value of this unit (KNQA credit framework).
  credits     Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework   AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  elements    CompetencyElement[]
  items       AssessmentItem[]
  roles       AssessmentRole[]

  @@unique([frameworkId, name])
  @@index([schoolId, frameworkId])
}

/// Observable sub-skill within a CompetencyUnit, e.g. "Use input devices"
/// within "Operate a Computer".
model CompetencyElement {
  id               String                 @id @default(cuid())
  schoolId         String
  competencyUnitId String
  name             String
  code             String?
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  competencyUnit   CompetencyUnit         @relation(fields: [competencyUnitId], references: [id], onDelete: Cascade)
  criteria         PerformanceCriterion[]
  items            AssessmentItem[]

  @@unique([competencyUnitId, name])
  @@index([schoolId])
  @@index([competencyUnitId])
}

/// Leaf-level evidence statement, e.g. "Demonstrates correct keyboard
/// technique without looking at keys". Assessed as COMPETENT / NOT_YET.
model PerformanceCriterion {
  id        String            @id @default(cuid())
  schoolId  String
  elementId String
  name      String
  code      String?
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  element   CompetencyElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  items     AssessmentItem[]

  @@unique([elementId, name])
  @@index([schoolId])
  @@index([elementId])
}

// ---------------------------------------------------------------------------
// AssessmentItem — the polymorphic result record
// ---------------------------------------------------------------------------
// One row = one student's result for one granular assessment node in one
// period. The result payload is polymorphic:
//
//   8-4-4   → numericScore      (Float, 0–maxMarks)
//   CBC     → performanceLevel  (EE/ME/AE/BE)
//   CBE     → competencyStatus  (COMPETENT/NOT_YET_COMPETENT)
//
// Exactly one of the three nullable result columns is populated. A DB-level
// CHECK constraint (see migration) enforces this. The `resultKind`
// discriminator makes the active column explicit at query time.
//
// Scope columns: subjectId / paperId / learningAreaId / strandId /
// subStrandId / competencyUnitId / elementId / criterionId are ALL nullable;
// exactly the right subset is populated depending on the framework and the
// granularity of the assessment node being recorded.

model AssessmentItem {
  id          String  @id @default(cuid())
  schoolId    String
  frameworkId String
  periodId    String
  studentId   String
  enteredById String? /// Teacher who entered this item

  /// ---- discriminator -------------------------------------------------
  resultKind AssessmentResultKind

  /// ---- result payload (exactly one non-null per row) ----------------
  numericScore     Float? /// 8-4-4
  performanceLevel PerformanceLevel? /// CBC
  competencyStatus CompetencyStatus? /// CBE

  /// ---- 8-4-4 scope --------------------------------------------------
  subjectId String? /// Subject (when not using papers)
  paperId   String? /// Paper within a subject

  /// ---- CBC scope -----------------------------------------------------
  learningAreaId String?
  strandId       String?
  subStrandId    String?

  /// ---- CBE scope -----------------------------------------------------
  competencyUnitId String?
  elementId        String?
  criterionId      String?

  /// ---- metadata -------------------------------------------------------
  /// Free-text assessor comment on this specific item.
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ---- relations ------------------------------------------------------
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework      AssessmentFramework   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  period         AssessmentPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy      Teacher?              @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  subject        Subject?              @relation(fields: [subjectId], references: [id])
  paper          Paper?                @relation(fields: [paperId], references: [id])
  learningArea   LearningArea?         @relation(fields: [learningAreaId], references: [id])
  strand         Strand?               @relation(fields: [strandId], references: [id])
  subStrand      SubStrand?            @relation(fields: [subStrandId], references: [id])
  competencyUnit CompetencyUnit?       @relation(fields: [competencyUnitId], references: [id])
  element        CompetencyElement?    @relation(fields: [elementId], references: [id])
  criterion      PerformanceCriterion? @relation(fields: [criterionId], references: [id])

  /// Natural uniqueness: one result per (student, period, scope node).
  /// The compound unique is on the most granular scope columns; the
  /// CHECK constraint in the migration ensures only one scope path is set.
  @@unique([studentId, periodId, paperId], name: "item_paper")
  @@unique([studentId, periodId, subStrandId], name: "item_substrand")
  @@unique([studentId, periodId, criterionId], name: "item_criterion")
  /// Fallback unique for subject-level (no paper) 8-4-4 items.
  @@unique([studentId, periodId, subjectId, paperId], name: "item_subject_paper")
  @@index([schoolId, frameworkId, periodId])
  @@index([studentId])
  @@index([enteredById])
  @@index([learningAreaId, periodId])
  @@index([competencyUnitId, periodId])
  /// Covering index for every dashboard/marksheet query: periodId + studentId IN [...] + resultKind filter.
  @@index([periodId, studentId, resultKind])
  /// Supports department analytics: subjectId IN [...] AND periodId filter.
  @@index([subjectId, periodId])
  @@index([schoolId, periodId, subjectId])
}

// ---------------------------------------------------------------------------
// Assessment RBAC — scoped assessment roles
// ---------------------------------------------------------------------------
// This is a parallel RBAC layer alongside the existing StaffRole/Module
// system. It grants a teacher a specific assessment *role* (e.g.
// SUBJECT_TEACHER, HOD, EXAM_OFFICER) for a specific *scope node* within
// one framework. Scope nodes are mutually exclusive per row:
//
//   Subject-level (8-4-4): subjectId populated
//   Learning-area (CBC)  : learningAreaId populated
//   Unit (CBE)           : competencyUnitId populated
//   School-wide          : all scope FKs null (role applies to whole school)
//
// A DB CHECK constraint in the migration enforces that at most one scope
// column is non-null per row.

/// The named roles a teacher can hold within an assessment framework.
/// These express *what they can do in this scope*, not module-level access.
enum AssessmentRoleType {
  /// Enters results for their assigned subjects / learning areas / units.
  SUBJECT_TEACHER
  /// Enters and reviews results for their own class across all areas.
  CLASS_TEACHER
  /// Head of Department — can view, moderate, and approve results in scope.
  HOD
  /// Exam Officer / Academic Deputy — school-wide moderation, can publish.
  EXAM_OFFICER
  /// Director / Principal / Academic Secretary — read-only full access.
  DIRECTOR
  /// Parent — read-only view of results for their linked child only.
  PARENT_VIEWER
}

/// Grants a teacher an AssessmentRoleType within a specific scope inside one
/// framework. Delete-cascade on teacher and framework; scope FKs are
/// set-null (if a learning area is deleted the role row loses its scope but
/// stays as a school-wide grant rather than disappearing silently).
model AssessmentRole {
  id          String             @id @default(cuid())
  schoolId    String
  frameworkId String
  teacherId   String
  role        AssessmentRoleType

  /// ---- scope (at most one non-null — enforced by DB CHECK) ----------
  subjectId        String? /// 8-4-4 subject scope
  learningAreaId   String? /// CBC learning area scope
  competencyUnitId String? /// CBE unit scope

  createdAt DateTime @default(now())

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  framework      AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  teacher        Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject        Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  learningArea   LearningArea?       @relation(fields: [learningAreaId], references: [id], onDelete: SetNull)
  competencyUnit CompetencyUnit?     @relation(fields: [competencyUnitId], references: [id], onDelete: SetNull)

  /// A teacher can only hold each role once per (framework, scope node).
  @@unique([frameworkId, teacherId, role, subjectId, learningAreaId, competencyUnitId])
  @@index([schoolId, frameworkId])
  @@index([teacherId])
}

// =============================================================================
// Examination Analytics — teacher ranking configuration
// =============================================================================

/// Per-school ranking weight configuration for the teacher composite score.
/// One row per school. Created on first PUT /api/settings/ranking-config call.
/// If no row exists, the service defaults to 0.4 / 0.3 / 0.3 in code.
model RankingConfig {
  schoolId          String   @id
  /// Weight for the improvement-over-previous-period component (0.0–1.0).
  improvementWeight Float    @default(0.4)
  /// Weight for the marks-entry completion component (0.0–1.0).
  completionWeight  Float    @default(0.3)
  /// Weight for the absolute class mean points component (0.0–1.0).
  absoluteWeight    Float    @default(0.3)
  /// Class mean grade points below which a class is flagged in the dashboard.
  /// Null means no flagging. Stored as a raw grade-points value (e.g. 5.0).
  meanFlagThreshold Float?
  updatedAt         DateTime @updatedAt
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Examination Analytics — per-student report remarks
// =============================================================================

/// One row per (school, period, student) — stores the AI-drafted remark and
/// any teacher-edited override. Created on first GET (AI draft generated)
/// or first PUT (manual save). Cascade-deletes with the school.
model ReportRemark {
  id            String           @id @default(cuid())
  schoolId      String
  periodId      String
  studentId     String
  /// AI-generated draft text. May be null if AI service was unavailable.
  draftRemark   String?
  /// Teacher-edited text. If non-null, this is used in the PDF/preview
  /// instead of draftRemark.
  editedRemark  String?
  isAiGenerated Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period        AssessmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, periodId, studentId])
  @@index([schoolId, periodId])
  /// Supports single-student report-remark lookup.
  @@index([periodId, studentId])
}

// =============================================================================
// Messaging / Communication Centre
// =============================================================================

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

/// A school-defined, named collection of recipients (e.g. "Board of Management").
/// Not hardcoded — created and managed entirely by authorised users.
model RecipientGroup {
  id            String                  @id @default(cuid())
  schoolId      String
  name          String
  description   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members       GroupMember[]
  messageGroups MessageRecipientGroup[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// One member of a RecipientGroup. Either a system person (teacherId or
/// studentId) OR an external contact (name + phone) — never both.
model GroupMember {
  id        String         @id @default(cuid())
  groupId   String
  /// System-linked teacher/admin staff member (optional)
  teacherId String?
  /// System-linked student — parent contact used as phone (optional)
  studentId String?
  /// External contact not in the system (optional)
  extName   String?
  extPhone  String?
  group     RecipientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  student   Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([teacherId])
  @@index([studentId])
}

/// A reusable named message body with optional placeholder tokens.
model MessageTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  category  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// One outbound communication event. recipientDescriptor is a JSON blob
/// describing who was addressed. Actual phone numbers are resolved at send
/// time and stored in MessageLog, never here.
model Message {
  id                  String                  @id @default(cuid())
  schoolId            String
  senderUserId        String
  channel             MessageChannel
  body                String
  /// JSON array of RecipientDescriptor objects — see src/lib/messaging/resolve.ts
  recipientDescriptor Json
  /// Human-readable summary stored for the history list
  recipientSummary    String
  attachmentUrl       String?
  attachmentName      String?
  /// Null = send immediately. Non-null = scheduled for this time.
  scheduledAt         DateTime?
  status              MessageStatus           @default(PENDING)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender              User                    @relation(fields: [senderUserId], references: [id])
  logs                MessageLog[]
  messageGroups       MessageRecipientGroup[]

  @@index([schoolId])
  @@index([schoolId, createdAt(sort: Desc)])
  @@index([schoolId, status])
  @@index([senderUserId])
}

/// One row per resolved recipient per message. Tracks delivery at the
/// individual phone-number level.
model MessageLog {
  id             String         @id @default(cuid())
  messageId      String
  schoolId       String
  channel        MessageChannel
  /// The phone number actually dialled for this log entry.
  phone          String
  recipientLabel String
  status         MessageStatus  @default(PENDING)
  providerMsgId  String?
  errorDetail    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  message        Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([schoolId])
  @@index([schoolId, status])
}

/// Join table linking a Message to the RecipientGroups it was addressed to.
model MessageRecipientGroup {
  messageId String
  groupId   String
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  group     RecipientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([messageId, groupId])
}

/// Per-school messaging configuration — one row per school, upserted on first save.
model MessagingSettings {
  schoolId       String   @id
  resultsClosing String   @default("Thank you for your continued support.")
  batchSize      Int      @default(50)
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Lifecycle Management — Audit Log
// =============================================================================

/// Immutable audit trail for lifecycle actions: student/staff archival,
/// expulsions, transfers, and graduations. Every action writes one row here
/// so administrators can always determine who acted, when, and why.
model AuditLog {
  id            String   @id @default(cuid())
  schoolId      String
  /// The type of action performed, e.g. "STUDENT_ARCHIVED", "STAFF_ARCHIVED"
  action        String
  /// JSON payload with entity info, e.g. { studentId, admissionNumber, name, archiveType, reason }
  detail        Json
  performedById String?
  performedAt   DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  performedBy   User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([schoolId, performedAt])
  @@index([schoolId, action])
}

// =============================================================================
// Accommodation Management Module
// =============================================================================
//
// Design decisions:
//
//  1. School-level boarding type (DAY_ONLY, BOARDING_ONLY, DAY_AND_BOARDING)
//     and gender policy (BOYS_ONLY, GIRLS_ONLY, MIXED) are stored on
//     AccommodationSettings so the module UI can self-configure without asking
//     the user to repeat what they told School Registration.
//
//  2. Dormitory is the primary entity. It can be OPEN_HALL (beds sit directly
//     inside the dorm) or CUBICLE_BASED (students first grouped into
//     Cubicle rows, then beds inside each cubicle).
//
//  3. SleepingPosition is the atomic unit of capacity. A single Bed may
//     produce 1 position (single), 2 positions (DOUBLE_DECKER — UPPER / LOWER),
//     or N positions (CUSTOM). Capacity is always derived from the count of
//     SleepingPosition rows, never from assumptions.
//
//  4. AllocationRecord ties one Student to one SleepingPosition.
//     A student can have at most one active allocation (CURRENT status).
//     Historical moves are captured in AllocationHistory for the audit trail.
//
//  5. DormPolicy / CubiclePolicy handle form-restriction vs mixed: RESTRICTED
//     means only the listed classes may be allocated there; MIXED means all
//     permitted classes.
//
// =============================================================================

/// Boarding type of the school — set once in School Settings / Registration.
/// Controls whether the Accommodation module is active and which UI options appear.
enum BoardingType {
  DAY_ONLY
  BOARDING_ONLY
  DAY_AND_BOARDING
}

/// Gender policy of the school/dorm.
enum GenderPolicy {
  BOYS_ONLY
  GIRLS_ONLY
  MIXED
}

/// Physical layout of a dormitory.
enum DormStructure {
  /// Beds placed directly inside the dorm — no subdivisions.
  OPEN_HALL
  /// Students first assigned to a Cubicle (room/bay), then to a Bed within it.
  CUBICLE_BASED
}

/// How students are allocated to a dorm or cubicle.
enum AllocationPolicy {
  /// Only students from the listed permitted forms/classes may be allocated.
  RESTRICTED_BY_FORM
  /// Students from any permitted form may be mixed together.
  MIXED_FORMS
}

/// The physical type of a bed, which determines how many sleeping positions it creates.
enum BedType {
  SINGLE
  DOUBLE_DECKER
  CUSTOM
}

/// The vertical position on a double-decker bed (null for SINGLE / CUSTOM beds).
enum BedPosition {
  UPPER
  LOWER
}

/// Operational status of a dormitory.
enum DormStatus {
  ACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

/// Allocation status of one sleeping position assignment.
enum AllocationStatus {
  CURRENT
  VACATED
  TRANSFERRED
  /// Student was in this dorm when it was closed/put under maintenance.
  /// The original dormId, cubicleId, bedId, sleepingPositionId are preserved
  /// so the student can be restored when the dorm is reactivated.
  MAINTENANCE_HOLD
}

// =============================================================================
// =============================================================================
// Accommodation Settings — module-wide school preferences (one row per school)
// =============================================================================

/// Per-school accommodation module configuration.
/// Created / updated via PUT /api/accommodation/settings.
model AccommodationSettings {
  schoolId                String           @id
  /// Whether boarding is enabled for this school (controls module visibility).
  boardingType            BoardingType     @default(DAY_AND_BOARDING)
  /// School-wide gender admission policy (guides dorm gender dropdown defaults).
  schoolGenderPolicy      GenderPolicy     @default(MIXED)
  /// Allow dorm captains to be assigned.
  enableDormCaptains      Boolean          @default(true)
  /// Allow student transfers between dorms.
  enableTransfers         Boolean          @default(true)
  /// Default allocation policy applied to newly created dorms.
  defaultAllocationPolicy AllocationPolicy @default(MIXED_FORMS)
  /// Percentage occupancy that triggers an "almost full" warning (e.g. 90).
  occupancyWarningPct     Int              @default(90)
  /// Whether bed-level tracking is enabled globally.
  bedTrackingEnabled      Boolean          @default(true)
  /// Show analytics widgets on the accommodation dashboard.
  analyticsEnabled        Boolean          @default(true)
  /// Send notification when a student is allocated / transferred.
  notifyOnAllocation      Boolean          @default(false)
  updatedAt               DateTime         @updatedAt
  school                  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Dormitory Inspection Models
// =============================================================================

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionRating {
  EXCELLENT
  GOOD
  SATISFACTORY
  NEEDS_IMPROVEMENT
  POOR
}

model DormInspection {
  id                 String            @id @default(cuid())
  schoolId           String
  dormId             String
  inspectionDate     DateTime
  inspectedById      String?
  status             InspectionStatus  @default(SCHEDULED)
  overallRating      InspectionRating?
  overallScore       Float?
  notes              String?
  recommendations    String?
  nextInspectionDate DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dorm        Dormitory            @relation(fields: [dormId], references: [id], onDelete: Cascade)
  inspectedBy User?                @relation(fields: [inspectedById], references: [id], onDelete: SetNull)
  items       DormInspectionItem[]

  @@index([schoolId])
  @@index([dormId])
  @@index([schoolId, inspectionDate])
}

model DormInspectionItem {
  id           String           @id @default(cuid())
  inspectionId String
  category     String
  item         String
  rating       InspectionRating
  score        Float?
  notes        String?
  createdAt    DateTime         @default(now())

  inspection DormInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// =============================================================================
// Accommodation Event Log (immutable audit trail)
// =============================================================================

enum AccomEventType {
  ALLOCATED
  TRANSFERRED
  VACATED
  REMOVED
  MAINTENANCE_CLOSED
  MAINTENANCE_REOPENED
  EMERGENCY_RELOCATION
  RESERVED
  RESERVATION_RELEASED
  RENOVATION_STARTED
  RENOVATION_COMPLETED
  REASSIGNED
  STATUS_CHANGED
}

model AccommodationEvent {
  id             String         @id @default(cuid())
  schoolId       String
  dormId         String?
  studentId      String?
  eventType      AccomEventType
  performedById  String?
  fromDormId     String?
  toDormId       String?
  fromCubicleId  String?
  toCubicleId    String?
  fromPositionId String?
  toPositionId   String?
  reason         String?
  notes          String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dorm        Dormitory? @relation(fields: [dormId], references: [id], onDelete: SetNull)
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  performedBy User?      @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([dormId])
  @@index([studentId])
  @@index([schoolId, createdAt])
  @@index([schoolId, eventType])
}

// =============================================================================
// Dormitory
// =============================================================================

/// One registered dormitory (boarding house).
model Dormitory {
  id                    String           @id @default(cuid())
  schoolId              String
  /// Human-readable name, e.g. "Simba House" or "Girls Block A".
  name                  String
  /// Gender of students housed here.
  genderPolicy          GenderPolicy     @default(MIXED)
  /// OPEN_HALL or CUBICLE_BASED.
  structure             DormStructure    @default(OPEN_HALL)
  /// Operational status.
  status                DormStatus       @default(ACTIVE)
  /// Total physical capacity (sleeping positions) — derived from Beds, but
  /// stored here as a cached/override value for fast dashboard queries.
  /// Recomputed whenever beds are added/removed.
  totalCapacity         Int              @default(0)
  /// Student allocation policy for the dorm as a whole.
  allocationPolicy      AllocationPolicy @default(MIXED_FORMS)
  /// For CUBICLE_BASED dorms: do cubicles inherit the dorm policy?
  cubiclesInheritPolicy Boolean          @default(true)
  /// Optional description / notes.
  description           String?
  /// The teacher (boarding master/matron) responsible for this dorm.
  boardingMasterId      String?
  /// Student dorm captain (student ID).
  dormCaptainId         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  boardingMaster Teacher? @relation("DormBoardingMaster", fields: [boardingMasterId], references: [id], onDelete: SetNull)
  dormCaptain    Student? @relation("DormCaptain", fields: [dormCaptainId], references: [id], onDelete: SetNull)

  cubicles          Cubicle[]
  beds              Bed[]
  permittedForms    DormPermittedForm[]
  allocations       AllocationRecord[]
  sleepingPositions SleepingPosition[]
  inspections       DormInspection[]
  events            AccommodationEvent[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

/// Permitted form/class levels for a dormitory (when allocationPolicy = RESTRICTED_BY_FORM).
/// Stores the form number (1, 2, 3, 4 …) not a specific class row, so the
/// restriction applies to all classes in that form year.
model DormPermittedForm {
  dormId String
  form   Int
  dorm   Dormitory @relation(fields: [dormId], references: [id], onDelete: Cascade)

  @@id([dormId, form])
  @@index([dormId])
}

// =============================================================================
// Cubicle — subdivision within a CUBICLE_BASED dorm
// =============================================================================

/// A room, bay, or cubicle within a CUBICLE_BASED dormitory.
model Cubicle {
  id               String            @id @default(cuid())
  dormId           String
  schoolId         String
  /// e.g. "A", "Room 1", "Bay 3"
  name             String
  /// Maximum number of sleeping positions in this cubicle (informational cap).
  capacity         Int               @default(4)
  /// Whether this cubicle has its own allocation policy (when cubiclesInheritPolicy = false).
  allocationPolicy AllocationPolicy? /// null = inherits from dorm
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  dorm              Dormitory              @relation(fields: [dormId], references: [id], onDelete: Cascade)
  school            School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  beds              Bed[]
  permittedForms    CubiclePermittedForm[]
  sleepingPositions SleepingPosition[]
  allocations       AllocationRecord[]

  @@unique([dormId, name])
  @@index([dormId])
  @@index([schoolId])
}

/// Permitted form levels for a specific cubicle (when it has its own policy).
model CubiclePermittedForm {
  cubicleId String
  form      Int
  cubicle   Cubicle @relation(fields: [cubicleId], references: [id], onDelete: Cascade)

  @@id([cubicleId, form])
  @@index([cubicleId])
}

// =============================================================================
// Bed & SleepingPosition
// =============================================================================

/// A physical bed in a dormitory (or cubicle). One bed creates 1-N
/// SleepingPosition rows depending on its type.
model Bed {
  id              String   @id @default(cuid())
  schoolId        String
  dormId          String
  cubicleId       String? /// null for OPEN_HALL beds
  /// Human label, e.g. "Bed 1", "Bunk A"
  label           String
  bedType         BedType  @default(SINGLE)
  /// For CUSTOM beds: number of sleeping positions to generate. Ignored for SINGLE/DOUBLE_DECKER.
  customOccupancy Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dorm        Dormitory          @relation(fields: [dormId], references: [id], onDelete: Cascade)
  cubicle     Cubicle?           @relation(fields: [cubicleId], references: [id], onDelete: SetNull)
  positions   SleepingPosition[]
  allocations AllocationRecord[]

  @@unique([dormId, label])
  @@index([dormId])
  @@index([cubicleId])
  @@index([schoolId])
}

/// One atomic sleeping space. For a SINGLE bed there is exactly one position.
/// For DOUBLE_DECKER there are two (UPPER + LOWER). For CUSTOM there are N.
/// This is the unit that is allocated to a student.
model SleepingPosition {
  id          String       @id @default(cuid())
  schoolId    String
  bedId       String
  dormId      String
  cubicleId   String?
  /// Positional label: null for SINGLE, UPPER/LOWER for DOUBLE_DECKER,
  /// e.g. "1"/"2"/"3" (stored as label) for CUSTOM.
  position    BedPosition?
  /// For CUSTOM positions: human label e.g. "Space 1".
  customLabel String?
  /// Whether this position is currently occupied (derived from AllocationRecord, cached).
  isOccupied  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bed         Bed                @relation(fields: [bedId], references: [id], onDelete: Cascade)
  dorm        Dormitory?         @relation(fields: [dormId], references: [id], onDelete: Cascade)
  cubicle     Cubicle?           @relation(fields: [cubicleId], references: [id], onDelete: SetNull)
  allocations AllocationRecord[]

  @@index([dormId])
  @@index([schoolId])
}

// =============================================================================
// AllocationRecord — student ↔ sleeping position assignment
// =============================================================================

/// One active or historical allocation of a student to a sleeping position.
/// Only one row per student should have status = CURRENT at any time.
model AllocationRecord {
  id                 String           @id @default(cuid())
  schoolId           String
  studentId          String
  dormId             String
  cubicleId          String?
  bedId              String?
  sleepingPositionId String?
  allocationDate     DateTime         @default(now())
  vacatedDate        DateTime?
  status             AllocationStatus @default(CURRENT)
  /// Free-text note (e.g. "Transferred due to disciplinary action").
  notes              String?
  allocatedById      String? /// User who performed the allocation
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dorm             Dormitory         @relation(fields: [dormId], references: [id], onDelete: Cascade)
  cubicle          Cubicle?          @relation(fields: [cubicleId], references: [id], onDelete: SetNull)
  bed              Bed?              @relation(fields: [bedId], references: [id], onDelete: SetNull)
  sleepingPosition SleepingPosition? @relation(fields: [sleepingPositionId], references: [id], onDelete: SetNull)
  allocatedBy      User?             @relation("AccommodationAllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId])
  @@index([dormId])
  /// Fast lookup for a student's current allocation.
  @@index([studentId, status])
  @@index([schoolId, status])
  /// Fast lookup of held allocations for a dorm (used on reactivation).
  @@index([dormId, status])
}

// =============================================================================
// Fees / Finance Ledger enums  (tasks 1.1 + 1.2 — fees-ledger spec)
// =============================================================================

/// The nature of a double-entry ledger line.
/// INVOICE creates a debit (student owes money).
/// PAYMENT / CREDIT_ADJUSTMENT reduce the balance.
/// DEBIT_ADJUSTMENT increases the balance (e.g. penalty).
/// OPENING_BALANCE is a one-time seed entry when migrating existing balances.
enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
  OPENING_BALANCE
}

/// How a payment was tendered.
enum PaymentMethod {
  MPESA
  CASH
  BANK_TRANSFER
  CHEQUE
}

/// Whether an M-Pesa STK-push / C2B callback has been matched to a ledger entry.
enum ReconciliationStatus {
  AUTO_MATCHED
  MANUAL_RECONCILED
  PENDING
}

/// Processing state of an M-Pesa callback held in the queue table
/// (used while the STK-push result is awaited or being re-tried).
enum MpesaQueueStatus {
  PENDING
  RESOLVED
  REJECTED
}

/// Types of fee-related notification events stored in the audit / notification log.
enum NotificationType {
  SETUP_REQUIRED
  REMINDER_SENT
  PAYMENT_RECEIVED
  INVOICE_GENERATED
  RECONCILIATION_NEEDED
}

/// Sub-type for finance bulk-import jobs (mirrors the existing ImportType enum
/// but scoped to the finance module to avoid polluting the shared enum).
enum FinanceImportType {
  PLAIN_LEDGER
  OPENING_BALANCE
}

/// Processing status for a finance bulk-import job.
enum FinanceImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// Fees & Ledger Module — Finance Models (tasks 1.3 — fees-ledger spec)
//
// Architecture: immutable, append-only LedgerEntry table backed by a
// materialised balance cache in StudentFinanceAccount. Every monetary event
// writes a LedgerEntry and updates the account atomically in the same
// transaction. Corrections are never edits — they are new offsetting rows.
//
// Dependency order: FinanceSettings → FeeStructure → ExpenseCategory →
// ExpenseItem → Term → StudentFinanceAccount → LedgerEntry → Invoice →
// Payment → StudentExpenseAttachment → MpesaReconciliationQueue →
// DebtorFlag → FinanceNotification → FinanceImportJob
// =============================================================================

/// School-level finance configuration — one row per school.
/// Created when the Bursar first accesses Finance Settings.
/// mpesaWebhookSecret is always stored AES-256-GCM encrypted via crypto.ts;
/// never the plaintext value.
model FinanceSettings {
  schoolId             String  @id
  /// Minimum balance (positive value) below which a student is considered in debt.
  /// e.g. 500 means the student is flagged when balance < -500.
  balanceThreshold     Decimal @default(0)
  /// Days overdue before the daily cron escalates a debtor flag.
  daysOverdueThreshold Int     @default(30)
  /// Prefix prepended to all receipt numbers, e.g. "REC-".
  receiptPrefix        String  @default("REC-")
  /// Prefix prepended to all invoice numbers, e.g. "INV-".
  invoicePrefix        String  @default("INV-")
  /// School's M-Pesa paybill or till number (informational).
  mpesaPaybillNumber   String?
  /// AES-256-GCM encrypted webhook secret from Daraja — never stored in plaintext.
  /// Null until the Bursar configures M-Pesa integration.
  mpesaWebhookSecret   String?
  /// Stable UUID path component that forms the C2B callback URL.
  /// Unique so no two schools share the same webhook endpoint.
  mpesaWebhookUrl      String? @unique

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// One M-Pesa paybill / till number configuration per school.
/// A school may have multiple paybills (e.g. main fees paybill + canteen till).
/// Each has its own Daraja webhook secret and a stable URL token.
/// Money flow is the same regardless of which paybill received the payment.
model SchoolMpesaPaybill {
  id               String   @id @default(cuid())
  schoolId         String
  /// Human label, e.g. "Main Fees Paybill" or "Canteen Till"
  label            String
  /// Safaricom paybill number or till number, e.g. "522533"
  paybillNumber    String
  /// AES-256-GCM encrypted Daraja webhook secret — never stored in plaintext.
  webhookSecret    String?
  /// Stable UUID token used as the URL path component for the C2B callback.
  /// Unique so no two paybills share the same endpoint.
  webhookUrl       String   @unique @default(cuid())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// A named term definition used as the "term label" in the financial module.
/// e.g. "Term 1", "Term 2", "Term 3". Schools create these once in Settings
/// and then reference them when setting up financial terms.
model FinancialTermName {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms         Term[]
  feeStructures FeeStructure[]
  expenseItems  ExpenseItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A fee tier that determines how much a student in a given form/stream/
/// boarding category owes per term. No delete — soft-retire by creating a
/// replacement row. The invoicing engine selects the most-specific match
/// (form + stream + boardingStatus wins over form only).
model FeeStructure {
  id             String   @id @default(cuid())
  schoolId       String
  /// Form number 1–4.
  form           Int
  /// Stream name, e.g. "North". Null = applies to all streams in this form.
  stream         String?
  /// "DAY" | "BOARDING" | null = applies to both boarding types. Kept for legacy.
  boardingStatus String?
  /// Links to a FinancialTermName definition e.g. "Term 1". Null = applies to all terms.
  termNameId     String?
  /// Base fee per term for students matching this structure.
  amountPerTerm  Decimal
  createdById    String
  createdAt      DateTime @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy  User               @relation(fields: [createdById], references: [id])
  termName   FinancialTermName? @relation(fields: [termNameId], references: [id])

  @@index([schoolId, form])
}

/// A named grouping of expense items, e.g. "Stationery", "Sports".
/// Used to organise the expense catalogue in the UI.
model ExpenseCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  /// Optional icon identifier (e.g. a Lucide icon name) for UI display.
  icon        String?
  createdAt   DateTime @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  ExpenseItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A chargeable expense item within a category, e.g. "Lab fees" at KES 500.
/// Items are attached to individual students; the attachment drives invoice
/// line-items on top of the base fee structure amount.
model ExpenseItem {
  id           String   @id @default(cuid())
  schoolId     String
  categoryId   String
  name         String
  description  String?
  /// Current price in school currency. Updated via PUT — history is implicit
  /// in already-generated invoice lineItems JSON.
  currentPrice Decimal
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Optional: links to a FinancialTermName — expense only applies in that term.
  /// Null = applies to all terms (default).
  termNameId   String?

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  termName    FinancialTermName?  @relation(fields: [termNameId], references: [id], onDelete: SetNull)
  attachments StudentExpenseAttachment[]

  @@index([schoolId])
  @@index([categoryId])
}

/// An academic term — the unit of invoicing. One term per school should have isActive = true at a time.
/// termNameId links to a FinancialTermName definition; academicYear describes the calendar year.
/// startDate/endDate are kept optional for legacy compatibility but are no longer required.
model Term {
  id                   String    @id @default(cuid())
  schoolId             String
  name                 String
  academicYear         Int
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean   @default(true)
  /// Set once runBatchInvoicing completes for this term.
  invoicingCompletedAt DateTime?
  /// When true, this term was created without fee structures. Invoices are
  /// supplied via CSV upload rather than auto-generated by the system.
  useCsvInvoice        Boolean   @default(false)
  createdById          String
  createdAt            DateTime  @default(now())

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy     User               @relation(fields: [createdById], references: [id])
  termName      FinancialTermName? @relation(fields: [termNameId], references: [id])
  termNameId    String?
  ledgerEntries LedgerEntry[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([schoolId, academicYear])
  @@index([schoolId, isActive])
}

/// Materialised per-student finance summary — one row per (school, student).
/// Updated atomically in the same transaction as every LedgerEntry write.
/// If the cache ever diverges, balance.ts:computeBalance() rebuilds it from
/// the ledger without data loss.
model StudentFinanceAccount {
  id                      String    @id @default(cuid())
  schoolId                String
  studentId               String    @unique
  /// Running balance: positive = credit (school owes student), negative = student owes school.
  currentBalance          Decimal   @default(0)
  totalInvoiced           Decimal   @default(0)
  totalPaid               Decimal   @default(0)
  lastActivityAt          DateTime  @default(now())
  /// Null until the Bursar explicitly completes finance setup for this student.
  financeSetupCompletedAt DateTime?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId])
  @@index([schoolId, currentBalance])
}

/// Immutable financial event log — the single source of truth for all money
/// movements. Never updated or deleted. Corrections are new offsetting rows.
///
/// Balance delta rules (applied by postLedgerEntry):
///   PAYMENT, CREDIT_ADJUSTMENT  → +amount  (reduces what student owes)
///   INVOICE, DEBIT_ADJUSTMENT, OPENING_BALANCE → -amount  (increases what student owes)
model LedgerEntry {
  id          String          @id @default(cuid())
  schoolId    String
  studentId   String
  termId      String?
  entryType   LedgerEntryType
  /// Always stored as a positive number; sign is implied by entryType.
  amount      Decimal
  description String
  referenceId   String?
  referenceType String?
  postedById  String
  postedAt    DateTime       @default(now())
  /// Unique M-Pesa transaction ID — prevents duplicate C2B callbacks creating
  /// duplicate ledger entries (idempotency key).
  mpesaTransactionId String?        @unique
  paymentMethod      PaymentMethod?
  /// True only when a correcting entry has been posted. Set via admin action;
  /// never deleted. Voided entries are excluded from balance computation.
  isVoided    Boolean        @default(false)

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)
  postedBy User    @relation(fields: [postedById], references: [id])

  @@index([schoolId, studentId, postedAt])
  @@index([schoolId, postedAt])
  @@index([mpesaTransactionId])
  @@index([schoolId, entryType])
}

/// One invoice per student per term — generated by runBatchInvoicing or
/// individually. The unique constraint makes invoicing idempotent: running
/// the batch job twice for the same term produces no duplicate invoices.
model Invoice {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  termId        String
  totalAmount   Decimal
  /// JSON array of line items: [{ description, amount, type }]
  lineItems     Json
  invoiceNumber String
  isProrated    Boolean  @default(false)
  /// Number of days remaining in the term when the student was enrolled
  /// (set when isProrated = true).
  proratedDays  Int?
  generatedById String
  generatedAt   DateTime @default(now())

  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term    @relation(fields: [termId], references: [id])
  generatedBy  User    @relation(fields: [generatedById], references: [id])

  /// Prevents duplicate invoices for the same student in the same term.
  @@unique([schoolId, studentId, termId])
  @@index([schoolId, termId])
  @@index([schoolId, invoiceNumber])
}

/// A recorded payment — cash, bank transfer, cheque, or M-Pesa.
/// M-Pesa payments may arrive via the C2B webhook (auto-matched) or be
/// posted manually by the Bursar. receiptNumber is unique per school and
/// generated via nextReceiptNumber() using a pg_advisory_xact_lock.
model Payment {
  id                   String               @id @default(cuid())
  schoolId             String
  studentId            String
  termId               String?
  amount               Decimal
  method               PaymentMethod
  /// Unique M-Pesa transaction ID — prevents duplicate webhook callbacks
  /// creating duplicate payment rows.
  mpesaTransactionId   String?              @unique
  /// Raw Safaricom C2B callback JSON, stored for audit and re-processing.
  mpesaRawPayload      Json?
  reference            String?
  receiptNumber        String
  paidAt               DateTime             @default(now())
  postedById           String
  reconciliationStatus ReconciliationStatus @default(PENDING)

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term?  @relation(fields: [termId], references: [id], onDelete: SetNull)
  postedBy User   @relation(fields: [postedById], references: [id])

  /// Receipt numbers are unique within a school.
  @@unique([schoolId, receiptNumber])
  @@index([schoolId, studentId, paidAt])
  @@index([schoolId, reconciliationStatus])
}

/// Links an individual student to an expense item so it appears as a
/// line item on their next invoice. detachedAt / detachedById support
/// soft-removal without deleting history.
model StudentExpenseAttachment {
  id            String    @id @default(cuid())
  studentId     String
  expenseItemId String
  schoolId      String
  attachedAt    DateTime  @default(now())
  attachedById  String
  detachedAt    DateTime?
  detachedById  String?

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expenseItem ExpenseItem @relation(fields: [expenseItemId], references: [id])
  /// Named relations required because User is referenced twice (attach + detach).
  attachedBy  User        @relation("ExpenseAttachedBy", fields: [attachedById], references: [id])
  detachedBy  User?       @relation("ExpenseDetachedBy", fields: [detachedById], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId])
  @@index([schoolId, expenseItemId])
  @@index([studentId, detachedAt])
}

/// Holds incoming M-Pesa C2B callbacks whose rawAccountNumber could not be
/// automatically matched to an admission number with high enough confidence.
/// The Bursar resolves each entry in the reconciliation UI.
model MpesaReconciliationQueue {
  id                  String           @id @default(cuid())
  schoolId            String
  /// Safaricom transaction ID — unique to prevent duplicate callbacks.
  mpesaTransactionId  String           @unique
  /// Raw account reference from the callback (may be mistyped / partial).
  rawAccountNumber    String
  amount              Decimal
  paidAt              DateTime
  /// Full Safaricom C2B callback JSON, preserved for audit.
  rawPayload          Json
  /// Best-match student found by Levenshtein fuzzy matching (may be null).
  suggestedStudentId  String?
  /// Normalised confidence score 0–1 from the fuzzy match.
  suggestedConfidence Float?
  status              MpesaQueueStatus @default(PENDING)
  resolvedById        String?
  resolvedAt          DateTime?
  /// Student the Bursar confirmed as the actual payer.
  resolvedStudentId   String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, paidAt])
}

/// Tracks students whose balance falls below the school's configured
/// threshold. Created/cleared atomically in every postLedgerEntry call and
/// by the daily cron job. Only one row with isCurrent = true may exist per
/// student at a time.
model DebtorFlag {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String
  flaggedAt         DateTime  @default(now())
  /// Balance snapshot at the time the flag was raised.
  balanceAtFlag     Decimal
  /// Days since the oldest unpaid INVOICE entry at flag time.
  daysOverdueAtFlag Int       @default(0)
  /// True while the student is still in debt. Set to false when balance recovers.
  isCurrent         Boolean   @default(true)
  /// Set when the flag is cleared (balance recovered above threshold).
  unflaggedAt       DateTime?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, isCurrent])
  @@index([schoolId, studentId])
}

/// In-app notification events for the Bursar's notification feed.
/// Created automatically by the system on invoice generation, payment receipt,
/// reconciliation needs, and new student setup requirements.
model FinanceNotification {
  id        String           @id @default(cuid())
  schoolId  String
  /// Null for school-wide notifications (e.g. reconciliation alerts).
  studentId String?
  type      NotificationType
  message   String
  /// Optional structured payload for rich notification rendering.
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, isRead, createdAt])
  @@index([schoolId, type])
}

/// Tracks a bulk finance import operation (opening balances or plain ledger
/// entries from CSV/XLSX). Files under 500 rows are processed synchronously;
/// larger files are queued and the client polls for status.
model FinanceImportJob {
  id            String              @id @default(cuid())
  schoolId      String
  importType    FinanceImportType
  fileName      String
  /// Resolved column → canonical field mapping saved for audit / re-use.
  columnMapping Json?
  status        FinanceImportStatus @default(QUEUED)
  totalRows     Int                 @default(0)
  succeeded     Int                 @default(0)
  failed        Int                 @default(0)
  /// Array of per-row error objects: [{ row, values, reason }].
  errorReport   Json?
  createdById   String
  createdAt     DateTime            @default(now())

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy  User   @relation(fields: [createdById], references: [id])

  @@index([schoolId, status])
  @@index([schoolId, createdAt])
}
