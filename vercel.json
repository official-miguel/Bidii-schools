{
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "nodeVersion": "20.x",
  "functions": {
    "src/app/api/timetable/v2/generate/route.ts": {
      "maxDuration": 90
    }
  },
  "crons": [
    {
      "path": "/api/finance/jobs/debtor-refresh",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/messaging/scheduled-flush",
      "schedule": "0 2 * * *"
    }
  ]
}
