# Bidii Mobile Environment Variables
# Copy this file to .env and fill in your values

# API Base URL - point to your bidii backend
API_BASE_URL=http://localhost:3000

# School ID - configured per device/installation
SCHOOL_ID=

# Sync interval in milliseconds (default: 5 minutes)
SYNC_INTERVAL=300000

# Enable debug logging
DEBUG=false

# ── Supabase (required for OTP auth) ─────────────────────────────────────────
# Expo exposes env vars prefixed with EXPO_PUBLIC_ to the client bundle.
# Find these in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://qakretnjeuhihodkrctq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Full URL of the Bidii web backend (for OTP verify endpoint).
# In production: https://your-domain.com
# In local dev with a physical device: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
