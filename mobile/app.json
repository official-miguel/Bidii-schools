{
  "expo": {
    "name": "Bidii Library",
    "slug": "bidii-library",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C7F7E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bidii.library",
      "infoPlist": {
        "NSCameraUsageDescription": "Bidii Library needs camera access to scan QR codes on books and library cards.",
        "NSPhotoLibraryUsageDescription": "Bidii Library needs access to your photo library to upload book cover images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C7F7E"
      },
      "package": "com.bidii.library",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bidii Library to access your camera for scanning QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow Bidii Library to scan barcodes on books."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "bidii-library"
  }
}
