# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Both URLs point to the same Supabase project. Prisma uses DATABASE_URL at
# runtime (via the transaction pooler, PgBouncer-compatible) and DIRECT_URL
# for migrations only (bypasses PgBouncer so DDL statements work correctly).
#
# Find your password: Supabase Dashboard → Project Settings → Database → Connection string
# Replace <project-ref> with your project reference and <password> with your DB password.
#
# Transaction pooler — runtime queries (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection — migrations only (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Used to sign session cookies (any long random string)
SESSION_SECRET="change-this-to-a-long-random-string"

# Encrypts each school's own API keys (Gemini, SMS, WhatsApp, Email, ...)
# before they're stored in the database — set once, back it up like any
# other production secret. Rotating it makes previously-saved keys
# unreadable (schools would need to re-enter them in Settings).
# Generate one with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY="change-this-to-a-long-random-string"

# ── Platform SMTP (Tier 2 fallback) ──────────────────────────────────────────
# Used to send staff one-time passwords when a school hasn't configured its own
# SMTP integration. The school's registered email is set as Reply-To so staff
# see the school as the apparent sender.
# Leave blank to disable — emails will only send via school-configured SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# The "From" name and address shown in email clients, e.g.:
# SMTP_FROM="Bidii School Platform <noreply@bidii.school>"
SMTP_FROM=""

# Public URL used in email links (no trailing slash)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and anon (public) key.
# Find both in: Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_* vars are safe to expose in the browser — they only carry the
# anon key, which is governed by Row Level Security (RLS) on every table.
# The SERVICE_ROLE_KEY is server-only (never sent to the client).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — bypasses RLS. NEVER expose to the browser or commit.
# Used only in server-side API routes that need to perform admin actions
# (e.g. creating a user record after OTP verification).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Supabase Storage bucket names ─────────────────────────────────────────────
# Create these two buckets in Supabase Dashboard → Storage → New bucket:
#   images  — profile photos, school logos   (public read, authenticated write)
#   reports — generated PDF reports          (private; signed URLs only)
SUPABASE_STORAGE_IMAGES_BUCKET="images"
SUPABASE_STORAGE_REPORTS_BUCKET="reports"

# ── File uploads (school logo & stamp) ───────────────────────────────────────
# BLOB_READ_WRITE_TOKEN is the legacy Vercel Blob token. File uploads are now
# routed to Supabase Storage. Keep this empty unless you still need Vercel Blob
# for other purposes.
BLOB_READ_WRITE_TOKEN=""

# ── Cron job authentication ───────────────────────────────────────────────────
# A secret bearer token used to authenticate Vercel cron job invocations.
# Vercel automatically attaches "Authorization: Bearer <CRON_SECRET>" to
# requests it makes to cron-job routes when this variable is set in your
# Vercel project environment settings.
# Generate one with: openssl rand -hex 32
# Set the same value in: Vercel Dashboard → Project → Settings → Environment Variables
CRON_SECRET="change-this-to-a-long-random-string"

# ── Upstash Redis (distributed rate limiting) ────────────────────────────────
# Required for login-endpoint rate limiting and parent-API rate limiting.
# Without these the login endpoint will REJECT all attempts (fail-closed).
#
# 1. Sign up at https://console.upstash.com/
# 2. Create a Redis database (free tier is sufficient)
# 3. Copy the REST URL and REST token from the database details page.
#
# The login route enforces:
#   - 10 attempts per IP per 15 minutes
#   - 5 failed attempts per identifier per 15 minutes
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-rest-token>"

# ── Timetable CP-SAT Solver ───────────────────────────────────────────────────
# URL of the Python OR-Tools microservice that generates timetables.
# The service must be running before any timetable generation request is made.
#
# Local development (run manually):
#   cd timetable-solver && pip install -r requirements.txt && python solver.py
#
# Docker:
#   docker build -t timetable-solver ./timetable-solver
#   docker run -p 8080:8080 timetable-solver
#
# Production (Railway):
#   Deploy the timetable-solver/ directory as a separate Railway service.
#   Railway will build via Dockerfile and expose a public HTTPS URL.
#   Copy that URL here — no port suffix needed (Railway handles TLS termination).
#   Example: TIMETABLE_SOLVER_URL="https://timetable-solver-production.up.railway.app"
#
# Set this same value in your Vercel project environment variables so the
# deployed Next.js app can reach the Railway solver.
TIMETABLE_SOLVER_URL="http://localhost:8080"
# ── Sentry error tracking ──────────────────────────────────────────────────────
# Set up at https://sentry.io — create a project, then copy the DSN from
# Project Settings > Client Keys (DSN).
#
# NEXT_PUBLIC_SENTRY_DSN  : browser + server error tracking (public, safe to commit)
# SENTRY_AUTH_TOKEN       : source-map upload token (keep secret, set in Vercel env vars)
# SENTRY_ORG              : your Sentry organisation slug
# SENTRY_PROJECT          : your Sentry project slug
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project-id>"
SENTRY_AUTH_TOKEN="sntrys_your_token_here"
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"